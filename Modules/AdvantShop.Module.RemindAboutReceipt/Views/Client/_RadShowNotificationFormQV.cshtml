@using AdvantShop.Core.UrlRewriter
@using AdvantShop.Module.RemindAboutReceipt.Service
@using AdvantShop.Web.Infrastructure.Extensions;


@model AdvantShop.Catalog.Offer
@{
    var url = UrlService.GetUrl();
    var scripts = new List<string>
{
        url + "modules/" + ModuleSettings.ModuleID + "/content/scripts/radShowNotificationForm/controllers/radShowNFController.js"
    };
    var version = Html.GetModuleVersion(ModuleSettings.ModuleID);
}

<div data-oc-lazy-load="[@String.Join(" ,", scripts.Select(x=>"'" + x + "?" + version + "'" ))]" style="width: 100%;">
    <div id="RemindDiscountModuleShowNotificationFormBlock" class="remind-about-receipt-button-wrapper remind-about-receipt-button-discount" 
         ng-controller="RADShowNFCtrl as radShowNF">
        <div class="modal-content">
            <a href="javascript:void(0);" ng-click="radShowNF.modalOpen('RemindDiscountModuleShowNotificationFormQv_@Model.OfferId');" class="" id="NotificationDiscount">
                <img ng-src="pictures/modules/remindaboutreceipt/{{ radShowNF.form.ImagePath }}" style="vertical-align: middle;" />
                {{ radShowNF.form.TextForUser }}
            </a>
        </div>
    </div>
</div>