@using AdvantShop.Core.UrlRewriter
@using AdvantShop.Module.RemindAboutReceipt.Service
@using AdvantShop.Web.Infrastructure.Extensions;

@model string

@{
    var url = UrlService.GetUrl();
    var scripts = new List<string>
{
        //url + "modules/" + ModuleSettings.ModuleID + "/content/styles/admin-style.css",
        url + "modules/" + ModuleSettings.ModuleID + "/content/scripts/radModulesettings/controllers/radModuleSettingsController.js"
    };
    var version = Html.GetModuleVersion(ModuleSettings.ModuleID);
}

<div data-oc-lazy-load="[@String.Join(",",scripts.Select(x => "'" + x + "?" + version + "'" ))]">
    <rad-module-settings></rad-module-settings>
</div>

@Html.Action("GetPromoContentBannersData", "RARAdmin")