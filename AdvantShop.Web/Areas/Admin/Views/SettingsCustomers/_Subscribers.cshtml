@{
    var isMobile = SettingsDesign.IsMobileTemplate;
}
<div ng-controller="SubscriptionCtrl as subscription" @Html.Raw(isMobile ? "ng-init=\"settingsCustomers.subscription = subscription\"" : "")>

    <div ng-cloak>
        <div class="sticky-page-name @(isMobile ? "" : " m-b-xs m-t-n-xs")" sticky sticky-top="0">
            <div class="page-name-block sticky-page-name-inner">
                <div class="page-name-block-item-main flex middle-xs setting--flex-column setting--m-b">
                    @if (!isMobile)
                    {
                        <h2 class="sticky-page-name-text m-t-none setting--align-top" data-e2e="SubscriptionTitle">
                            @T("Admin.Subscription.Index.Title")
                        </h2>
                    }
                    <a href="@LinkService.Internal.AccountPlatform/help/pages/subscribers-to-news" target="_blank" class="p-l-sm link-academy link-invert inline-flex middle-xs setting--align-top setting--help-link">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 512 512" style="enable-background:new 0 0 512 512;" xml:space="preserve" width="18" height="18" fill="#989a9b" class="m-r-xs">
                        <path d="M20.005,512c-5.097,0-10.116-1.948-13.925-5.641c-5.845-5.666-7.672-14.309-4.621-21.855l45.411-112.333  C16.162,332.253,0,285.425,0,236c0-63.375,26.855-122.857,75.62-167.489C123.891,24.331,187.952,0,256,0  s132.109,24.331,180.38,68.511C485.145,113.143,512,172.625,512,236c0,45.448-14.04,89.577-40.602,127.615  c-6.325,9.057-18.792,11.271-27.849,4.947s-11.271-18.792-4.947-27.849C460.452,309.425,472,273.215,472,236  c0-108.075-96.897-196-216-196S40,127.925,40,236c0,43.783,15.577,85.2,45.046,119.773c4.834,5.671,6.115,13.561,3.321,20.47  l-31.366,77.589l91.345-40.266c5.063-2.231,10.826-2.267,15.916-0.095C193.082,425.766,223.946,432,256,432  c36.892,0,73.299-8.587,105.286-24.832c9.85-5,21.887-1.072,26.889,8.775c5.001,9.849,1.073,21.887-8.775,26.889  C341.828,461.914,299.157,472,256,472c-34.48,0-67.835-6.191-99.276-18.413L28.068,510.301C25.474,511.444,22.728,512,20.005,512z   M276,325V217c0-11.046-8.954-20-20-20s-20,8.954-20,20v108c0,11.046,8.954,20,20,20S276,336.046,276,325z M256,128  c-11.046,0-20,8.954-20,20l0,0c0,11.046,8.954,20,20,20s20-8.954,20-20l0,0C276,136.954,267.046,128,256,128z"></path>
                        </svg>
                        <span>@T("Admin.Subscription.Index.Instruction")</span>
                    </a>
                </div>
                @if (!isMobile)
                {
                    <div class="page-name-block-item-additional">
                        <button class="btn btn-sm btn-success btn--margin-left" type="button" data-e2e="subscriptionImport"
                                ngf-max-size="150MB"
                                ngf-select=""
                                ngf-change="subscription.upload($files, $file, $newFiles, $duplicateFiles, $invalidFiles, $event)">
                            @T("Admin.Subscribe.Index.Import")
                        </button>
                        <a class="btn btn-sm btn-success btn--margin-left" href="@Url.AbsoluteActionUrl("Export", "Subscription")" data-e2e="subscriptionExport">
                            @T("Admin.Subscribe.Index.Export")
                        </a>
                    </div>
                }
                @if (isMobile)
                {
                    <button style="display:none;" class="subscription__import-btn--callback-click" type="button" data-e2e="subscriptionImport"
                            ngf-max-size="150MB"
                            ngf-select=""
                            ngf-change="subscription.upload($files, $file, $newFiles, $duplicateFiles, $invalidFiles, $event)">
                    </button>
                }
            </div>
        </div>
        <ui-grid-custom grid-unique-id="gridSubscibers"
                        grid-row-identificator="'Id'"
                        grid-options="subscription.gridOptions"
                        grid-on-init="subscription.gridOnInit(grid)"
                        grid-url="'Subscription/getSubscribes'"
                        grid-inplace-url="'Subscription/InplaceSubscription'"
                        grid-extend-ctrl="subscription"
                        grid-swipe-line="true">
            @*<ui-grid-custom-override-header-control>
                <span class="ui-grid-custom-override-header__cell">Email</span>
                <span class="ui-grid-custom-override-header__cell">Активен</span>
            </ui-grid-custom-override-header-control>*@
            <ui-grid-custom-override-control class="ng-cloak">
                    <div class="card card--gap-row-sm card--p-18">
                        <div class="flex between-xs center-xs">
                            <div class="card__col m-r-xs flex middle-xs">
                                {{row.entity.Email}}
                            </div>
                            <div class="card__col card__col--end setting--align-center">
                                <ui-grid-custom-switch row="row" field-name="Enabled" class="js-grid-not-clicked"></ui-grid-custom-switch>
                            </div>
                        </div>
                    </div>
            </ui-grid-custom-override-control>
            <ui-grid-custom-footer class="ui-grid-custom-footer" ng-bind="subscription.grid.gridOptions.TotalString">
            </ui-grid-custom-footer>
        </ui-grid-custom>
    </div>
    <style type="text/css">
        .ui-grid-cell-contents, .ui-grid-header-cell-primary-focus {
            text-align: center;
        }

        .onoffswitch-inner-on {
            padding-right: 20px !important;
        }
    </style>

    <div class="adv-panel-info m-t-md setting__mobile-adv-panel-info">
        <a href="@LinkService.Internal.AccountPlatform/help/pages/subscribers-to-news" target="_blank" class="p-l-xs m-t-xs ">@T("Admin.Subscription.Index.Instruction")</a>
    </div>
</div>