        @Html.DropDownList("ddlExportMode", new SelectList(Model.ExportModes, "value", "label", (int)Model.ExportMode), new { @class = "form-control input-alt", ng_init = "exportFeeds.AdvancedSettings.ExportMode=" + ((int)Model.ExportMode), ng_model = "exportFeeds.AdvancedSettings.ExportMode" })
        <help-trigger class="ng-cloak m-l-xs help-trigger-icon-abs @(isMobile ? "p-l-sm" : "")" data-title="@T("Admin.ExportFeed.SettingsAvito.ExportMode.Help.Title")">
            <div class="help-content">
                @T("Admin.ExportFeed.SettingsAvito.ExportMode.Help.Body")
            </div>
        </help-trigger>    
    </div>
</div>

<div class="form-group row middle-xs setting__form-group" 
     style="display: none;">
    @if (!isMobile)
    {
        <div class="col-xs-12 col-md-3 col-wl-2">
            <div class="setting-label-wrap setting__label">
                @Html.LabelFor(x => x.DontExportMainPhoto, T("Admin.ExportFeed.SettingsAvito.DontExportMainPhoto"))
            </div>
        </div>
    }
    <div class="col-xs-12 col-md-5 col-wl-4 relative @(isMobile ? "flex middle-xs" : "")">
        <label class="adv-checkbox-label" data-e2e="CsvCategorySort">
            @Html.CheckBoxFor(x => x.DontExportMainPhoto, 
                new
                {
                    @class = "adv-checkbox-input", 
                    data_ng_init = "exportFeeds.AdvancedSettings.DontExportMainPhoto=" + Model.DontExportMainPhoto.ToLowerString(), 
                    data_ng_model = "exportFeeds.AdvancedSettings.DontExportMainPhoto"
                })
            <span class="adv-checkbox-emul"></span>
        </label>
        @if (isMobile)
        {
            @Html.LabelFor(x => x.DontExportMainPhoto, T("Admin.ExportFeed.SettingsAvito.DontExportMainPhoto"), 
                new
                {
                    @class = "setting__label m-l-sm flex-grow"
                })
        }
    </div>
</div>

<div class="adv-panel-info setting__mobile-adv-panel-info adv-panel-info--show">
    <a href="https://www.advantshop.net/help/pages/nastroika-vygruzki-avito-avtozagruzka" target="_blank">Инструкция. Настройка выгрузки "Avito Автозагрузка"</a>
</div>