@model AdvantShop.Web.Admin.Models.Catalog.ExportFeeds.ExportFeedSettingsAvitoModel

@{
    var isMobile = SettingsDesign.IsMobileTemplate;
}

<div class="form-group row middle-xs setting__form-group">
    <div class="col-xs-12 col-md-3 col-wl-2">
        <div class="setting-label-wrap setting__label">
            @Html.LabelFor(x => x.AdditionalUnloadingId, T("Дополнительный идентификатор выгрузки"))
        </div>
    </div>
    <div class="col-xs-12 col-md-5 col-wl-4 relative @(isMobile ? "flex middle-xs" : "")">
        @Html.TextBoxFor(x => x.AdditionalUnloadingId, new { @class = "form-control input-alt", @maxlength = "100", ng_init = "'@Model.AdditionalUnloadingId'",
            ng_model = "exportFeeds.AdvancedSettings.AdditionalUnloadingId", validation_input_text = T("введите дополнительный идентификатор выгрузки") })
        <help-trigger class="ng-cloak help-trigger-icon-abs m-l-xs @(isMobile ? "p-l-sm" : "")" data-title="Дополнительный идентификатор">
            <div class="help-content">
                <p>Нужно заполнить данное поле уникальным текстом для дублирования объявлений по другому адресу, если они уже были выгружены на Авито. В ином случае изменения произойдут в ранее выгруженных товарах</p>
            </div>
        </help-trigger>
    </div>
</div>

<div class="form-group row middle-xs setting__form-group">
    <div class="col-xs-12 col-md-3 col-wl-2">
        <div class="setting-label-wrap setting__label">
            @Html.LabelFor(x => x.Currency, T("Admin.ExportFeeed.SettingsAvito.Currency"), new { @class = "required" })
        </div>
    </div>
    <div class="@(isMobile ? "col-xs-11" : "col-xs-12") col-md-5 col-wl-4">
        @Html.DropDownList("ddlCurrency", new SelectList(Model.Currencies, "Key", "Value", Model.Currency), new { @class = "form-control input-alt", ng_init = "exportFeeds.AdvancedSettings.Currency='" + Model.Currency + "'", ng_model = "exportFeeds.AdvancedSettings.Currency" })
    </div>
    <help-trigger class="m-l-xs" data-title="@T("Admin.ExportFeeed.SettingsAvito.Currency.Help.Title")">
        <div class="help-content">
            @T("Admin.ExportFeeed.SettingsAvito.Currency.Help.Body")
        </div>
    </help-trigger>
</div>


@if (Model.PriceRulesEnabled && Model.PriceRules.Count > 0)
{
    <div class="form-group row middle-xs setting__form-group">
        <div class="col-xs-12 col-md-3 col-wl-2">
            <div class="setting-label-wrap setting__label">
                @Html.LabelFor(x => x.PriceRuleId, T("Admin.ExportFeed.SettingsYandex.PriceRule"), new { @class = "required" })
            </div>
        </div>
        <div class="col-xs-12 col-md-5 col-wl-4  @(isMobile ? "flex middle-xs" : "")">
            @Html.DropDownList("ddlPriceRuleId",
                new SelectList(Model.PriceRulesList, "Value", "Text", Model.PriceRuleId),
                new { @class = "form-control input-alt-mobile", ng_init = "exportFeeds.AdvancedSettings.PriceRuleId='" + Model.PriceRuleId + "'", ng_model = "exportFeeds.AdvancedSettings.PriceRuleId" })
            @if (isMobile)
            {
                <help-trigger class="ng-cloak m-l-xs p-l-sm" data-title="@T("Admin.ExportFeed.SettingsYandex.PriceRule")" style="height:50%;">
                    <div class="help-content">
                        @T("Admin.ExportFeed.SettingsYandex.PriceRule.Help")
                    </div>
                </help-trigger>
            }
        </div>
        @if (!isMobile)
        {
            <help-trigger class="ng-cloak m-l-xs" data-title="@T("Admin.ExportFeed.SettingsYandex.PriceRule")" style="height:50%;">
                <div class="help-content">
                    @T("Admin.ExportFeed.SettingsYandex.PriceRule.Help")
                </div>
            </help-trigger>
        }
    </div>
}


