@using AdvantShop.Web.Admin.ViewModels.Shared.Common
@model AdvantShop.Web.Admin.ViewModels.Shared.Service.RoleAccessIsDeniedViewModel
@{
    var isMobile = SettingsDesign.IsMobileTemplate;
    
    if (isMobile)
    {
        var headerModel = new HeaderViewModel
        {
            Title = Model.Title,
            ShowOnlySticky = true
        };

        if (HttpContext.Current.Request.UrlReferrer != null)
        {
            var urlReferrer = HttpContext.Current.Request.UrlReferrer.ToString();

            if (urlReferrer.StartsWith(UrlService.GetAdminUrl()))
            {
                headerModel.Back = new BackViewModel
                {
                    Text = string.Empty,
                    Url = urlReferrer,
                };
            }
        }
    
        @Html.Header(headerModel);
    }
}
<div class="js-iframe-wrap">

    <div class="row">
        <div class="col-xs-12">
            <div class="ibox">
                <div class="ibox-content text-center">
                    @if (!isMobile) 
                    {
                        <h2>
                            @Model.Title
                        </h2>
                    }
                    <p>
                        @Model.Description
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

