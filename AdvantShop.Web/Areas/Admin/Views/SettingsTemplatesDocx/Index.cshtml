            <div class="col-xs-4">
                <div class="text-right">
                    <ui-modal-trigger data-controller="'ModalAddEditTemplateCtrl'" controller-as="ctrl" on-close="settingsTemplatesDocx.gridTemplates.fetchData()" backdrop="static"
                                      template-url="@Html.GetAssetPath("addEditTemplate.html")">
                        <button class="btn btn-sm btn-success" type="button"
                                disabled ng-disabled="!settingsTemplatesDocx.gridTemplatesInited">
                            <span class="fa fa-plus"></span>
                            @T("Admin.Settings.TemplatesDocx.Templates.AddTemplate")
                        </button>
                    </ui-modal-trigger>
                </div>
            </div>
        </div>
    </div>

    <uib-tabset active uid="templatesDocxTab">
        <uib-tab index="'templates'" heading="@T("Admin.Settings.TemplatesDocx.Templates")" classes="ng-tab" removable="true">
            @Html.Partial("_Templates")
        </uib-tab>
    </uib-tabset>
}

