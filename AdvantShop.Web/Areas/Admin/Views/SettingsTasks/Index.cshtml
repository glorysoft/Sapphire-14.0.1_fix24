@using AdvantShop.Saas
@using AdvantShop.Core.Services.Admin
@model AdvantShop.Web.Admin.Models.Settings.TasksSettingsModel
@{
    Layout = "~/Areas/Admin/Views/Settings/_SettingsLayout.cshtml";
    var isAdminv3 = AdminAreaTemplate.Current == "adminv3";
    var haveTasks = !SaasDataService.IsSaasEnabled || SaasDataService.CurrentSaasData.HaveTasks;
    var isMobile = SettingsDesign.IsMobileTemplate;
    Html.AddAsset("settingsTasks");
}

@using (Html.BeginAbsoluteUrlForm("Index", "SettingsTasks", FormMethod.Post, new { name = "form", enctype = "multipart/form-data", novalidate = "novalidate" }))
{
    var headerModel = new AdvantShop.Web.Admin.ViewModels.Shared.Common.HeaderViewModel();
    headerModel.DefaultTitle = T("Admin.Settings.Commonpage.Tasks").ToString();
    headerModel.ShowOnlySticky = true;

    headerModel.Back = new AdvantShop.Web.Admin.ViewModels.Shared.Common.BackViewModel()
    {
        Text = T("Admin.Settings.IndexSettings").ToString(),
        Url = Url.AbsoluteActionUrl("Index", "Settings"),
        NgBackTriggerCallback = "settingsTasks.onSelectTab(null)"
    };

    headerModel.Controls = new List<IButton>();

    headerModel.Controls.Add(
        new ButtonModel()
        {
            Modificators = new List<eButtonModificators>()
            {
                eButtonModificators.OnlyIcon
            },
            ColorType = eColorType.Secondary,
            Type = eButtonType.Add,
            // Attributes = new[] { "ng-if=\"settingsTasks.tabActiveIndex === 'tasksBusinessProcesses' && settingsTasks.TasksActive\"" },
            WrapStart = " <ui-modal-trigger ng-if=\"settingsTasks.tabActiveIndex === 'tasksBusinessProcesses' && settingsTasks.TasksActive\" data-controller=\"'ModalAddEditRuleCtrl'\" controller-as=\"ctrl\" size=\"middle\" template-url=\"../areas/admin/content/src/settingsTasks/modal/addEditRule/AddEditRule.html\" data-on-close=\"settingsTasks.updateGrid(settingsTasks.bussinessEventType)\" data-resolve=\"{event:{ type: settingsTasks.bussinessEventType} }\">",
            WrapEnd = "</ui-modal-trigger>",
            Icon = new ButtonIcon()
            {
                SvgName = "plus-alt",
                Attributes = new { width = 16, height = 16 },
            }
        }
        );

    headerModel.Controls.Add(
        new ButtonModel()
        {
            Modificators = new List<eButtonModificators>()
            {
                eButtonModificators.OnlyIcon
            },
            ColorType = eColorType.Secondary,
            Type = eButtonType.Add,
            // Attributes = new[] { "ng-if=\"settingsTasks.tabActiveIndex === 'taskGroups'\"" },
            WrapStart = " <ui-modal-trigger ng-if=\"settingsTasks.tabActiveIndex === 'taskGroups'\" data-controller=\"'ModalAddEditTaskGroupCtrl'\" controller-as=\"ctrl\" size=\"middle\" template-url=\"" + @Html.GetAssetPath("addEditTaskGroup.html") + "\" data-on-close=\"settingsTasks.taskgroups.grid.fetchData()\">",
            WrapEnd = "</ui-modal-trigger>",
            Icon = new ButtonIcon()
            {
                SvgName = "plus-alt",
                Attributes = new { width = 16, height = 16 },
            }
        }
        );

    headerModel.Controls.Add(
        new ButtonModel()
        {
            Modificators = new List<eButtonModificators>()
            {
                eButtonModificators.OnlyIcon
            },
            ColorType = eColorType.Secondary,
            Type = eButtonType.Save,
            Attributes = new[] { "ng-if=\"settingsTasks.tabActiveIndex === 'tasks'\"", "type=\"submit\"", "data-button-validation disabled", "ng-disabled=\"!form.modified\"" },
            Icon = new ButtonIcon()
            {
                SvgName = "done",
                Attributes = new { width = 25, height = 25 }
            }
        }
        );

    @Html.Header(headerModel)

    if (!isMobile)
    {
        <div class="sticky-page-name p-n m-n" sticky sticky-top="0">
            <div class="page-name-block sticky-page-name-inner header-hidden">
                <div class="page-name-block-item-main">
                    <h1 class="page-name-block-text sticky-page-name-text">
                        <span class="float-header-page" ng-bind="app.getTitle()"></span>
                    </h1>
                </div>
                <div class="page-name-block-item-additional">
                    <input type="submit" class="btn btn-sm btn-success" value="@T("Admin.Save")" data-button-validation disabled ng-disabled="!form.modified"/>
                </div>
            </div>
        </div>
    }


    if (isAdminv3 && !isMobile)
    {
        @Html.Back(T("Admin.Settings.Commonpage.Tasks.Settings").ToString(), Url.AbsoluteActionUrl("Index", "Settings"))
        <div class="sticky-page-name">
            <div class="row middle-xs">
                <div class="col-xs-6 flex">
                    <h1 class="page-name-block-text">@T("Admin.Settings.Commonpage.Tasks")</h1>
                    <a href="@LinkService.Internal.AccountPlatform/help/pages/add-zadach" target="_blank" class="p-l-sm link-academy link-invert inline-flex middle-xs" style="padding-top:2px;">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 512 512" style="enable-background:new 0 0 512 512;" xml:space="preserve" width="18" height="18" fill="#989a9b" class="m-r-xs">
                            <path d="M20.005,512c-5.097,0-10.116-1.948-13.925-5.641c-5.845-5.666-7.672-14.309-4.621-21.855l45.411-112.333  C16.162,332.253,0,285.425,0,236c0-63.375,26.855-122.857,75.62-167.489C123.891,24.331,187.952,0,256,0  s132.109,24.331,180.38,68.511C485.145,113.143,512,172.625,512,236c0,45.448-14.04,89.577-40.602,127.615  c-6.325,9.057-18.792,11.271-27.849,4.947s-11.271-18.792-4.947-27.849C460.452,309.425,472,273.215,472,236  c0-108.075-96.897-196-216-196S40,127.925,40,236c0,43.783,15.577,85.2,45.046,119.773c4.834,5.671,6.115,13.561,3.321,20.47  l-31.366,77.589l91.345-40.266c5.063-2.231,10.826-2.267,15.916-0.095C193.082,425.766,223.946,432,256,432  c36.892,0,73.299-8.587,105.286-24.832c9.85-5,21.887-1.072,26.889,8.775c5.001,9.849,1.073,21.887-8.775,26.889  C341.828,461.914,299.157,472,256,472c-34.48,0-67.835-6.191-99.276-18.413L28.068,510.301C25.474,511.444,22.728,512,20.005,512z   M276,325V217c0-11.046-8.954-20-20-20s-20,8.954-20,20v108c0,11.046,8.954,20,20,20S276,336.046,276,325z M256,128  c-11.046,0-20,8.954-20,20l0,0c0,11.046,8.954,20,20,20s20-8.954,20-20l0,0C276,136.954,267.046,128,256,128z"></path>
                        </svg>
                        <span>@T("Admin.Settings.Commonpage.Tasks.Instructions")</span>
                    </a>
                </div>
                <div class="col-xs-6">
                    <div class="text-right">
                        <input type="submit" class="btn btn-sm btn-success" value="@T("Admin.Save")" data-button-validation disabled ng-disabled="!form.modified" data-e2e="settingsTasksSave"/>
                    </div>
                </div>
            </div>
        </div>
    }

    @Html.AntiForgeryToken()
    
    <uib-tabset uid="tasksTab"
                ng-init="settingsTasks.TasksActive=@(Model.TasksActive.ToLowerString()); @(!Model.TasksActive ? "settingsTasks.setTabIndex('tasks')":"")"
                active="settingsTasks.tabActiveIndex"
                on-select-batch="settingsTasks.onSelectTab(tab.index);"
                @Html.Raw(isMobile ? "tabs-mode=\"'navigation'\" class=\"tabs-navigation\"" : "")>
        <uib-tab index="'tasks'" heading="@T("Admin.Settings.Tasks.Common")" classes="ng-tab">
            @if (haveTasks)
            {
                @Html.Partial("_Tasks", Model)
            }
            else
            {
                @Html.Action("GetFeature", "Service", new { id = ESaasProperty.HaveTasks.ToString(), partial = true })
            }
        </uib-tab>
        @if (Model.TasksActive)
        {
            <uib-tab index="'taskGroups'" heading="@T("Admin.TaskGroups.Index.Title")" classes="ng-tab">
                @if (haveTasks)
                {
                    @Html.Partial("_TaskGroups")
                }
                else
                {
                    @Html.Action("GetFeature", "Service", new { id = ESaasProperty.HaveTasks.ToString(), partial = true })
                }
            </uib-tab>
            <uib-tab index="'tasksBusinessProcesses'" heading="@T("Admin.Settings.Tasks.BizProcesses")" classes="ng-tab">
                @if (haveTasks)
                {
                    @Html.Partial("_TasksBusinessProcesses", Model)
                }
                else
                {
                    @Html.Action("GetFeature", "Service", new { id = ESaasProperty.HaveTasks.ToString(), partial = true })
                }
            </uib-tab>
        }
        @if (!isAdminv3)
        {
            <div class="js-not-tabs">
                <input type="submit" class="btn btn-sm btn-success" value="@T("Admin.Save")" data-button-validation disabled ng-disabled="!form.modified" data-e2e="settingsTasksSave"/>
            </div>
        }
    </uib-tabset>
}