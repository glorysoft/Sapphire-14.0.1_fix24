@{
    var isMobile = SettingsDesign.IsMobileTemplate;
}


<div ng-controller="SizesCtrl as sizes" @Html.Raw(isMobile ? "ng-init=\"settingsCatalog.sizes = sizes\"" : "")>
    <div class="sticky-page-name @(isMobile ? "" : "m-t-n-xs")" sticky sticky-top="0">
        <div class="page-name-block sticky-page-name-inner">
            <div class="page-name-block-item-main flex middle-xs setting--flex-column @(isMobile ? "m-b" : "")">
                @if (!isMobile)
                {
                    <h2 class="sticky-page-name-text m-t-none setting--align-top setting__subtitle" data-e2e="SizeSettingTitle">
                        @T("Admin.Sizes.Index.Title")
                    </h2>
                }
                <a href="@LinkService.Internal.AccountPlatform/help/pages/spravochniki#2" target="_blank" class="setting--help-link p-l-sm link-academy link-invert inline-flex middle-xs setting--align-top" @*style="padding-top:2px;"*@>
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 512 512" style="enable-background:new 0 0 512 512;" xml:space="preserve" width="18" height="18" fill="#989a9b" class="m-r-xs">
                    <path d="M20.005,512c-5.097,0-10.116-1.948-13.925-5.641c-5.845-5.666-7.672-14.309-4.621-21.855l45.411-112.333  C16.162,332.253,0,285.425,0,236c0-63.375,26.855-122.857,75.62-167.489C123.891,24.331,187.952,0,256,0  s132.109,24.331,180.38,68.511C485.145,113.143,512,172.625,512,236c0,45.448-14.04,89.577-40.602,127.615  c-6.325,9.057-18.792,11.271-27.849,4.947s-11.271-18.792-4.947-27.849C460.452,309.425,472,273.215,472,236  c0-108.075-96.897-196-216-196S40,127.925,40,236c0,43.783,15.577,85.2,45.046,119.773c4.834,5.671,6.115,13.561,3.321,20.47  l-31.366,77.589l91.345-40.266c5.063-2.231,10.826-2.267,15.916-0.095C193.082,425.766,223.946,432,256,432  c36.892,0,73.299-8.587,105.286-24.832c9.85-5,21.887-1.072,26.889,8.775c5.001,9.849,1.073,21.887-8.775,26.889  C341.828,461.914,299.157,472,256,472c-34.48,0-67.835-6.191-99.276-18.413L28.068,510.301C25.474,511.444,22.728,512,20.005,512z   M276,325V217c0-11.046-8.954-20-20-20s-20,8.954-20,20v108c0,11.046,8.954,20,20,20S276,336.046,276,325z M256,128  c-11.046,0-20,8.954-20,20l0,0c0,11.046,8.954,20,20,20s20-8.954,20-20l0,0C276,136.954,267.046,128,256,128z"></path>
                    </svg>
                    <span>@T("Admin.Sizes.Index.Instruction")</span>
                </a>
            </div>
            @if (!isMobile)
            {
                <div class="page-name-block-item-additional">
                    <ui-modal-trigger data-controller="'ModalAddEditSizeNameForCategoriesCtrl'" controller-as="ctrl" size="xs-6"
                                      template-url="@Html.GetAssetPath("addEditSizeNameForCategories.html")">
                        <button class="btn btn-sm btn-success" data-e2e="SizeSettingAddNameForCategories" type="button">
                            @T("Admin.Sizes.Index.AddSizeNameForCategories")
                        </button>
                    </ui-modal-trigger>
                    <ui-modal-trigger data-controller="'ModalAddEditSizeCtrl'" controller-as="ctrl"
                                      template-url="@Html.GetAssetPath("addEditSize.html")"
                                      data-on-close="sizes.grid.fetchData()">
                        <button class="btn btn-sm btn-success btn--margin-left" data-e2e="SizeSettingAdd" type="button">
                            <span class="fa fa-plus"></span>
                            @T("Admin.Sizes.Index.AddSize")
                        </button>
                    </ui-modal-trigger>
                </div>
            }
        </div>
    </div>

    <div class="">
        <ui-grid-custom grid-unique-id="gridSizes"
                        grid-on-init="sizes.gridOnInit(grid)"
                        grid-options="sizes.gridOptions"
                        grid-url="'sizes/getsizes'"
                        grid-inplace-url="'sizes/inplacesize'"
                        grid-extend-ctrl="sizes"
                        grid-swipe-line="true">
            <ui-grid-custom-override-header-control>
                <span class="ui-grid-custom-override-header__cell">@T("Admin.Views.SettingCatalog.Sizes.Name")</span>
                <span class="ui-grid-custom-override-header__cell">@T("Admin.Views.SettingCatalog.Sizes.UsedForProducts")</span>
            </ui-grid-custom-override-header-control>
            <ui-grid-custom-override-control class="ng-cloak">
                @Html.Partial("../../Templates/Mobile/Views/SettingsCatalog/SizesGridItemInSettingCatalog")
            </ui-grid-custom-override-control>
            <ui-grid-custom-footer class="ui-grid-custom-footer" ng-bind="sizes.grid.gridOptions.TotalString">
            </ui-grid-custom-footer>
        </ui-grid-custom>
    </div>
    <div class="adv-panel-info m-t-md setting__mobile-adv-panel-info setting--m-none">
        <a href="@LinkService.Internal.AccountPlatform/help/pages/spravochniki#2" target="_blank" class="p-l-xs m-t-xs setting--m-none">@T("Admin.Sizes.Index.Instruction")</a>
    </div>
</div>