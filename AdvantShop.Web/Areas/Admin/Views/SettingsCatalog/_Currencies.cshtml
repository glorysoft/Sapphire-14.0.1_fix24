@model AdvantShop.Web.Admin.Models.Settings.CatalogSettings.CatalogSettingsModel

@{
    var isMobile = SettingsDesign.IsMobileTemplate;
}

<div class="sticky-page-name setting--m-b-sm @(isMobile ? "" : "m-t-n-xs")" sticky sticky-top="0">
    <div class="page-name-block sticky-page-name-inner">
        <div class="page-name-block-item-main flex middle-xs m-t-none  setting--flex-column">
            @if (!isMobile)
            {
                <h3 class="sticky-page-name-text bold setting__subtitle setting--align-top" data-e2e="CurrenciesSettingTitle">
                    @T("Admin.Settings.Catalog.Currencies")
                </h3>
            }
            <a class="inline-flex link-academy link-invert middle-xs p-l-sm p-b-xs setting--align-top setting--help-link" href="@LinkService.Internal.AccountPlatformNotSecure/help/pages/currency" target="_blank">
                <svg class="m-r-xs" fill="#989a9b" height="18" id="Layer_1" style="enable-background:new 0 0 512 512;" version="1.1" viewBox="0 0 512 512" width="18" x="0px" xml:space="preserve" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" y="0px">
                <path d="M20.005,512c-5.097,0-10.116-1.948-13.925-5.641c-5.845-5.666-7.672-14.309-4.621-21.855l45.411-112.333  C16.162,332.253,0,285.425,0,236c0-63.375,26.855-122.857,75.62-167.489C123.891,24.331,187.952,0,256,0  s132.109,24.331,180.38,68.511C485.145,113.143,512,172.625,512,236c0,45.448-14.04,89.577-40.602,127.615  c-6.325,9.057-18.792,11.271-27.849,4.947s-11.271-18.792-4.947-27.849C460.452,309.425,472,273.215,472,236  c0-108.075-96.897-196-216-196S40,127.925,40,236c0,43.783,15.577,85.2,45.046,119.773c4.834,5.671,6.115,13.561,3.321,20.47  l-31.366,77.589l91.345-40.266c5.063-2.231,10.826-2.267,15.916-0.095C193.082,425.766,223.946,432,256,432  c36.892,0,73.299-8.587,105.286-24.832c9.85-5,21.887-1.072,26.889,8.775c5.001,9.849,1.073,21.887-8.775,26.889  C341.828,461.914,299.157,472,256,472c-34.48,0-67.835-6.191-99.276-18.413L28.068,510.301C25.474,511.444,22.728,512,20.005,512z   M276,325V217c0-11.046-8.954-20-20-20s-20,8.954-20,20v108c0,11.046,8.954,20,20,20S276,336.046,276,325z M256,128  c-11.046,0-20,8.954-20,20l0,0c0,11.046,8.954,20,20,20s20-8.954,20-20l0,0C276,136.954,267.046,128,256,128z"></path>
            </svg>
                <span>@T("Admin.SettingsCatalog.Currencies.InstructionsSettingCurrency")</span>
            </a>
        </div>
        @if (!isMobile)
        {
            <div class="page-name-block-item-additional">
                <button class="btn btn-sm btn-success" data-e2e="CurrenciesSettingUpdate" type="button" ng-click="settingsCatalog.updateCb()">
                    <span class="fa fa-plus"></span>
                    @T("Admin.Settings.Catalog.UpdateCB")
                </button>

                <ui-modal-trigger data-controller="'ModalAddEditCurrencyCtrl'" controller-as="ctrl" on-close="settingsCatalog.modalProcessResult()"
                                  template-url="@Html.GetAssetPath("AddEditCurrency.html")">
                    <button class="btn btn-sm btn-success" type="button" data-e2e="CurrenciesSettingAdd">
                        <span class="fa fa-plus"></span>
                        @T("Admin.Settings.Catalog.AddCurrency")
                    </button>
                </ui-modal-trigger>
            </div>
        }
    </div>
</div>

<div class="form-group row middle-xs setting__form-group">
    <div class="col-xs-12 col-md-3 col-wl-2">
        <div class="setting-label-wrap setting__label">
            @T("Admin.Settings.Catalog.DefaultCurrency")
        </div>
    </div>
    <div class="col-xs-12 col-md-4 relative @(isMobile ? "flex middle-xs" : "")">
        <select name="DefaultCurrencyIso3" class="form-control input-alt"
                ng-model="settingsCatalog.DefaultCurrencyIso3"
                ng-options="s.label for s in settingsCatalog.currencies track by s.value"
                ng-init="settingsCatalog.initCurrencies({label: '@Model.DefaultCurrencyName', value: '@Model.DefaultCurrencyIso3'})"></select>
        <help-trigger class="ng-cloak help-trigger-icon-abs @(isMobile ? "m-l-xs p-l-sm" : "m-l-xs")" classes="'setting__catalog-popover-custom'" data-title='@T("Admin.Settings.Catalog.DefaultCurrency")'>
            @T("Admin.Settings.Catalog.DefaultCurrencyHint")
        </help-trigger>
    </div>
</div>

@if (!isMobile)
{
    <div class="form-group row setting__form-group">
        <div class="col-xs-12 col-md-3 col-wl-2">
            <div class="setting-label-wrap setting__label">
                @T("Admin.Settings.Catalog.AllowToChangeCurrency")
            </div>
        </div>
        <div class="col-xs-12 col-md-4">
            <label class="adv-checkbox-label">
                @Html.CheckBoxFor(x => x.AllowToChangeCurrency, new { @class = "adv-checkbox-input", ng_model = "settingsCatalog.AllowToChangeCurrency" })
                <span class="adv-checkbox-emul" data-e2e="AllowToChangeCurrency"></span>
            </label>
            <help-trigger class="ng-cloak m-l-xs" classes="'setting__catalog-popover-custom'" data-title='@T("Admin.Settings.Catalog.AllowToChangeCurrency")'>
                @T("Admin.Settings.Catalog.AllowToChangeCurrencyHint")
            </help-trigger>
        </div>
    </div>

    <div class="form-group row setting__form-group">
        <div class="col-xs-12 col-md-3 col-wl-2">
            <div class="setting-label-wrap setting__label">
                @T("Admin.Settings.Catalog.AutoUpdateCurrencies")
            </div>
        </div>
        <div class="col-xs-12 col-md-4">
            <label class="adv-checkbox-label">
                @Html.CheckBoxFor(x => x.AutoUpdateCurrencies, new { @class = "adv-checkbox-input", ng_model = "settingsCatalog.AutoUpdateCurrencies" })
                <span class="adv-checkbox-emul" data-e2e="AutoUpdateCurrencies"></span>
            </label>
            <help-trigger class="ng-cloak m-l-xs" classes="'setting__catalog-popover-custom'" data-title='@T("Admin.Settings.Catalog.AutoUpdateCurrencies")'>
                @T("Admin.Settings.Catalog.AutoUpdateCurrenciesHint")
            </help-trigger>
        </div>
    </div>
}
else
{
    <div class="form-group setting__form-group">
        <div class="flex middle-xs">
            <label class="adv-checkbox-label flex-grow">
                @Html.CheckBoxFor(x => x.AllowToChangeCurrency, new { @class = "adv-checkbox-input", ng_model = "settingsCatalog.AllowToChangeCurrency" })
                <span class="adv-checkbox-emul" data-e2e="AllowToChangeCurrency"></span>
                <span class="flex-grow m-l-sm setting__label">@T("Admin.Settings.Catalog.AllowToChangeCurrency")</span>
            </label>
            <help-trigger class="ng-cloak @(isMobile ? "m-l-xs p-l-sm" : "")" classes="'setting__catalog-popover-custom'" data-title='@T("Admin.Settings.Catalog.AllowToChangeCurrency")'>
                @T("Admin.Settings.Catalog.AllowToChangeCurrencyHint")
            </help-trigger>
        </div>
    </div>

    <div class="form-group setting__form-group">
        <div class="flex middle-xs">
            <label class="adv-checkbox-label flex-grow">
                @Html.CheckBoxFor(x => x.AutoUpdateCurrencies, new { @class = "adv-checkbox-input", ng_model = "settingsCatalog.AutoUpdateCurrencies" })
                <span class="adv-checkbox-emul" data-e2e="AutoUpdateCurrencies"></span>
                <span class="flex-grow m-l-sm setting__label">@T("Admin.Settings.Catalog.AutoUpdateCurrencies")</span>
            </label>
            <help-trigger class="ng-cloak @(isMobile ? "m-l-xs p-l-sm" : "")" classes="'setting__catalog-popover-custom'" data-title='@T("Admin.Settings.Catalog.AutoUpdateCurrencies")'>
                @T("Admin.Settings.Catalog.AutoUpdateCurrenciesHint")
            </help-trigger>
        </div>
    </div>
}


<div class="m-t-md">
    <ui-grid-custom ng-if="settingsCatalog.tabCurrencyShow"
                    grid-unique-id="gridCurrencies"
                    grid-row-identificator="'CurrencyId'"
                    grid-on-init="settingsCatalog.gridCurrenciesOnInit(grid)"
                    grid-options="settingsCatalog.gridCurrenciesOptions"
                    grid-url="'settingsCatalog/getCurrenciesPaging'"
                    grid-inplace-url="'settingsCatalog/currencyInplace'"
                    grid-extend-ctrl="settingsCatalog"
                    grid-on-delete="settingsCatalog.updateCurrencies()"
                    grid-on-inplace-apply="settingsCatalog.updateCurrencies(rowEntity, colDef, newValue, oldValue)"
                    grid-swipe-line="true">
        <ui-grid-custom-override-header-control>
            <span class="ui-grid-custom-override-header__cell">@T("Admin.Views.SettingCatalog.Currencies.Name")</span>
            <span class="ui-grid-custom-override-header__cell">@T("Admin.Views.SettingCatalog.Currencies.Value")</span>
        </ui-grid-custom-override-header-control>
        <ui-grid-custom-override-control class="ng-cloak">
            @Html.Partial("../../Templates/Mobile/Views/SettingsCatalog/CurrenciesGridItemInSettingCatalog")
        </ui-grid-custom-override-control>
    </ui-grid-custom>
</div>