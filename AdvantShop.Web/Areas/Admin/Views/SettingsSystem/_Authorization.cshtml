@using AdvantShop.Core.Services.Configuration.Settings.Enums
@model AdvantShop.Web.Admin.Models.Settings.SystemSettingsModel

@{
    var isMobile = SettingsDesign.IsMobileTemplate;
}

<div class="setting-title-top">
    <h3 class="setting__subtitle">
        @T("Admin.Settings.SystemSettings.Authorization.Title")
    </h3>
</div>

<div class="form-group row middle-xs setting__form-group">
    <div class="col-xs-12 col-md-3">
        <div class="setting-label-wrap setting__label">
            @Html.LabelFor(
                model => model.AuthMethod,
                T("Admin.Settings.SystemSettings.Autorization.DefaultAuthorizationMethod")
            )
        </div>
    </div>
    <div class="col-xs-12 col-md-3 relative @(isMobile ? "flex middle-xs" : "")">
        @Html.DropDownListFor(
            model => model.AuthMethod,
            Model.AuthMethods,
            new
            {
                @class = "form-control input-alt",
                data_ng_model = "settingsSystem.AuthMethod"
            }
        )
        <help-trigger class="ng-cloak help-trigger-icon-abs @(isMobile ? "m-l-sm p-l-xs" : "")" 
                      data-title="@T("Admin.Settings.SystemSettings.Autorization.DefaultAuthorizationMethod")">
            @T("Admin.Settings.SystemSettings.Autorization.DefaultAuthorizationMethod.Help")
        </help-trigger>
    </div>
</div>

