@if (TrialService.IsTrialEnabled)
{
    <div class="row middle-xs setting__form-group">
        <div class="col-xs-12"
             data-ng-tg-title="'Удалить тестовые данные'"
             data-ng-tg-tour="'Иногда перед началом работы с каталогом необходимо очистить магазин от тестовых данных.<br><br> Удалите нужные демонстрационные данные по этой ссылке.'"
             data-ng-tg-group="'clearData'"
             data-ng-tg-order="10"
             data-ng-tg-hide-nav="true"
             data-ng-click="ngTour.callbackShortFire('exit')">
            <ui-modal-trigger data-controller="'ModalClearDataCtrl'" 
                              controller-as="ctrl"
                              data-resolve="{'params': {'mode': 'settingsSystem'}}"
                              template-url="@Html.GetAssetPath("ClearData.html")">
                <a class="link-invert" href="">
                    @T("Admin.Settings.ClearData")
                </a>
            </ui-modal-trigger>
        </div>
    </div>
}

