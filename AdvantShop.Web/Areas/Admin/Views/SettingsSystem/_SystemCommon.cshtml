<div class="form-group row setting__form-group">
    <div class="col-xs-12 col-md-3">
        <label for="settingsSystemCopyrightMode" class="control-label">
            @Html.LabelFor(x => x.CopyrightMode, T("Admin.Settings.Template.CopyrightText"))
        </label>
    </div>
    <div class="col-xs-12 col-md-4 @(isMobile ? "flex middle-xs flex-wrap" : "")">
        @if (!Model.DisableCopyrightEdit)
        {
        <div class="relative @(isMobile ? "flex middle-xs flex-grow" : "")">
            @Html.DropDownListFor(x => x.CopyrightMode, new List<SelectListItem>
                {
                    new SelectListItem
                    {
                        Text = T("Admin.Settings.SystemSettings.CopyrightMode.Default").ToString(),
                        Value = "default",
                        Selected = !Model.ShowCustomCopyright
                    },
                    new SelectListItem
                    {
                        Text = T("Admin.Settings.SystemSettings.CopyrightMode.Custom").ToString(),
                        Value = "custom",
                        Selected = Model.ShowCustomCopyright
                    }
                }, new
                {
                    id = "settingsSystemCopyrightMode",
                    @class = "form-control input-alt-mobile",
                    ng_model = "settingsSystem.CopyrightMode",
                    ng_disabled = Model.DisableCopyrightEdit.ToLowerString()
                })
            <help-trigger class="ng-cloak @(isMobile ? "m-l-sm p-l-xs" : "help-trigger-icon-abs m-l-xs")" data-title='@T("Admin.Settings.Template.CopyrightText")'>
                @T("Admin.Settings.SystemSettings.ShowCopyrightNote")
            </help-trigger>
