@model AdvantShop.Web.Admin.Models.Catalog.WarehouseGroups.WarehouseGroupModel
@{
    var isMobile = SettingsDesign.IsMobileTemplate;
}

<div class="row pictures">
    <div class="col-xs-12 col-md-3 col-lg-3 col-wl-2">
        <h2 class="category-title @(isMobile ? "setting__subtitle" : "")">@T("Admin.Category.Pictures")</h2>
    </div>
    <div class="col-xs-12 col-md-9 col-wl-10">
        <div class="ibox category-block">
            <div class="ibox-content category-content border_none">
                
                <div class="row category-row @(isMobile ? "form-group" : "")">
                    <div class="col-xs-12 col-md-2">
                        <div class="form-label form-label--block">
                            @T("Admin.Warehouse.AddEdit.WarehouseDescription.Photo")
                            <div ng-if="isMobile.value" style="font-weight: 400">
                                @T("Admin.Warehouse.AddEdit.WarehouseDescription.PhotoHint")
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-10">
                        @Html.PictureUploader(
                            AdvantShop.Catalog.PhotoType.WarehouseGroupPhoto,
                            Model.Id,
                            Model.Photo.ImageSrcPhoto() ?? UrlService.GetUrl() + "images/nophoto_small.png",
                            "warehouseGroup.updatePhoto(result)",
                            new
                            {
                                @class = "picture-uploader-middle"
                            }, Model.Photo.PhotoId)
                        @Html.HiddenFor(x => x.PhotoId, new { ng_value = "warehouseGroup.PhotoId" })
                        <div class="m-t-xs @(!isMobile ? "setting-size-text" : "ng-hide")">
                            @T("Admin.Warehouse.AddEdit.WarehouseDescription.PhotoHint")
                        </div>
                    </div>
                </div>
                
                <div class="row category-row @(isMobile ? "form-group" : "")">
                    <div class="col-xs-12 col-md-2">
                        <div class="form-label form-label--block">
                            @T("Admin.Warehouse.AddEdit.WarehouseDescription.Logo")
                            <div ng-if="isMobile.value" style="font-weight: 400">
                                @T("Admin.Warehouse.AddEdit.WarehouseDescription.LogoHint")
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-10">
                        @Html.PictureUploader(
                               AdvantShop.Catalog.PhotoType.WarehouseGroupLogo,
                               Model.Id,
                               Model.Logo.ImageSrcLogo() ?? UrlService.GetUrl() + "images/nophoto_small.png",
                               "warehouseGroup.updateLogo(result)",
                               new
                               {
                                   @class = "picture-uploader-middle"
                               }, Model.Logo.PhotoId)
                        @Html.HiddenFor(x => x.LogoId, new { ng_value = "warehouseGroup.LogoId" })
                        <div class="m-t-xs @(!isMobile ? "setting-size-text" : "ng-hide")">
                            @T("Admin.Warehouse.AddEdit.WarehouseDescription.LogoHint")
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>