@model AdvantShop.Web.Admin.Models.Settings.SEOSettingsModel

@{
    var isMobile = SettingsDesign.IsMobileTemplate;
}

<div class="ng-cloak">
    <div class="sticky-page-name">
        <div class="page-name-block sticky-page-name-inner">
            <div class="page-name-block-item-main">
                <div class="flex middle-xs setting--flex-column">
                    @if (!isMobile)
                    {
                        <h2 class="sticky-page-name-text setting--m-t-none setting--align-top">
                            @T("Admin.Settings.System.301Redirects")
                        </h2>
                    }
                    <a href="@LinkService.Internal.AccountPlatform/help/pages/robots-txt#3" target="_blank" class="p-l-sm link-academy link-invert inline-flex middle-xs setting--align-top setting--help-link">
                        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 512 512" style="enable-background:new 0 0 512 512;" xml:space="preserve" width="18" height="18" fill="#989a9b" class="m-r-xs">
                            <path d="M20.005,512c-5.097,0-10.116-1.948-13.925-5.641c-5.845-5.666-7.672-14.309-4.621-21.855l45.411-112.333  C16.162,332.253,0,285.425,0,236c0-63.375,26.855-122.857,75.62-167.489C123.891,24.331,187.952,0,256,0  s132.109,24.331,180.38,68.511C485.145,113.143,512,172.625,512,236c0,45.448-14.04,89.577-40.602,127.615  c-6.325,9.057-18.792,11.271-27.849,4.947s-11.271-18.792-4.947-27.849C460.452,309.425,472,273.215,472,236  c0-108.075-96.897-196-216-196S40,127.925,40,236c0,43.783,15.577,85.2,45.046,119.773c4.834,5.671,6.115,13.561,3.321,20.47  l-31.366,77.589l91.345-40.266c5.063-2.231,10.826-2.267,15.916-0.095C193.082,425.766,223.946,432,256,432  c36.892,0,73.299-8.587,105.286-24.832c9.85-5,21.887-1.072,26.889,8.775c5.001,9.849,1.073,21.887-8.775,26.889  C341.828,461.914,299.157,472,256,472c-34.48,0-67.835-6.191-99.276-18.413L28.068,510.301C25.474,511.444,22.728,512,20.005,512z   M276,325V217c0-11.046-8.954-20-20-20s-20,8.954-20,20v108c0,11.046,8.954,20,20,20S276,336.046,276,325z M256,128  c-11.046,0-20,8.954-20,20l0,0c0,11.046,8.954,20,20,20s20-8.954,20-20l0,0C276,136.954,267.046,128,256,128z"></path>
                        </svg>
                        <span>@T("Admin.Settings.System.301Redirects.Instruction")</span>
                    </a>
                </div>
                <label class="adv-checkbox-label form-label-block m-t-sm" style="@(isMobile ? "margin:10px 0 !important;" : "")">
                    @Html.CheckBoxFor(
                        model => model.EnableRedirect301, 
                        new
                        {
                            @class = "adv-checkbox-input", 
                            data_ng_model = "settingsSeo.active301",
                            data_ng_init = "settingsSeo.active301 = " + Model.EnableRedirect301.ToLowerString()
                        }
                    )
                    <span data-e2e="EnableRedirect301" class="adv-checkbox-emul"></span>
                    <span class="">@T("Admin.SettingsSeo.Activity301")</span>
                </label>
            </div>
            @if (!isMobile)
            {
                <div>
                    <div class="flex">
                        <div class="page-name-block-item-additional">
                            <ui-modal-trigger data-controller="'ModalImport301RedCtrl'" controller-as="ctrl"
                                              template-url="@Html.GetAssetPath("import301Red.html")"
                                              data-on-close="settingsSeo.grid301Red.fetchData()">
                                <a data-e2e="ExportCards" class="btn btn-sm btn-link btn--margin-left" style="min-width: 60px;" href="">
                                    @T("Admin.Settings.System.301Redirects.Import")
                                </a>
                            </ui-modal-trigger>
                        </div>
                        <div class="page-name-block-item-additional">
                            <a data-e2e="ExportCards" class="btn btn-sm btn-link btn--margin-left" style="min-width: 60px;" href="" ng-click="settingsSeo.startExport301Red()">
                                @T("Admin.Settings.System.301Redirects.Export")
                            </a>
                        </div>
                        <ui-modal-trigger data-controller="'ModalAddEdit301RedCtrl'" controller-as="ctrl"
                                          template-url="@Html.GetAssetPath("addEdit301Red.html")"
                                          data-on-close="settingsSeo.grid301Red.fetchData()">
                            <button data-e2e="AddRedirect" class="btn btn-sm btn-success btn--margin-left" type="button">
                                <span class="fa fa-plus"></span> @T("Admin.Settings.System.301Redirects.Add")
                            </button>
                        </ui-modal-trigger>
                    </div>
                </div>
            }
        </div>
    </div>

    <ui-grid-custom grid-unique-id="grid301Red"
                    grid-row-identificator="'ID'"
                    grid-options="settingsSeo.gridOptions301Red"
                    grid-on-init="settingsSeo.grid301RedOnInit(grid)"
                    grid-url="'redirect301/getRedirect301'"
                    grid-inplace-url="'redirect301/InplaceRedirect301'"
                    grid-extend-ctrl="settings"
                    grid-swipe-line="true">
        <ui-grid-custom-override-control class="ng-cloak">
            <ui-modal-trigger data-controller="'ModalAddEdit301RedCtrl'" controller-as="ctrl" 
                            template-url="@Html.GetAssetPath("addEdit301Red.html")" 
                            data-resolve="{'id': row.entity.ID}" 
                            data-on-close="grid.appScope.$ctrl.fetchData()">
                        <div class="card card--gap-row-sm card--p-18">
                            <div class="">
                                <div class="card__col m-r-xs flex middle-xs">
                                    <span class="setting--grid-span-grey setting--m-t-none m-r-xs">Откуда:</span>{{row.entity.RedirectFrom}}
                                </div>
                                <div class="card__col m-r-xs flex middle-xs m-t-sm">
                                    <span class="setting--grid-span-grey setting--m-t-none m-r-xs">Куда:</span>{{row.entity.RedirectTo}}
                                </div>
                            </div>
                        </div>
               </ui-modal-trigger>
        </ui-grid-custom-override-control>
        <ui-grid-custom-footer class="ui-grid-custom-footer" ng-bind="settingsSeo.grid301Red.gridOptions.TotalString">
        </ui-grid-custom-footer>
    </ui-grid-custom>

    <div class="adv-panel-info m-t-md setting__mobile-adv-panel-info">
        <a href="@LinkService.Internal.AccountPlatform/help/pages/robots-txt#3" target="_blank" class="p-l-xs m-t-xs ">@T("Admin.Settings.System.301Redirects.Instruction")   </a>
    </div>
</div>

