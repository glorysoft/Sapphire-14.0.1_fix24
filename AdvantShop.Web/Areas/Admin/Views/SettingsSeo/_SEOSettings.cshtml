<div class="form-group middle-xs row setting__form-group">
    <div class="col-xs-12 col-md-2">
        <div class="setting-label-wrap text-required setting__label">
            @Html.LabelFor(x => x.DefaultTitle, T("Admin.Settings.SeoSettings.DefaultTitle"))
        </div>
    </div>
    <div class="col-xs-12 col-md-6">
        @Html.TextBoxFor(x => x.DefaultTitle,
            new
            {
                @class = "form-control input-alt",
                ng_model = "settingsSeo.DefaultTitle",
                textcomplete = "",
                textcomplete_data = Html.Action("MetaVariablesComplete", "Common", new {type = AdvantShop.SEO.MetaType.Default}),
                required = "required",
                validation_input_text = string.Format("{0} - {1}", T("Admin.Settings.SeoSettings.Default"), T("Admin.Settings.SeoSettings.DefaultTitle"))
            })
