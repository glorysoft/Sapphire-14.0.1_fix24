        </svg>
        <span>@T("Admin.Settings.PaymentMethods.InstructionPayMethods")</span>
    </a>
    <payment-methods-list></payment-methods-list>
}
else
{
    <div class="ibox">
        <uib-tabset active uid="payments">
            <uib-tab index="1" heading="@T("Admin.Settings.PaymentMethods")" classes="ng-tab">
                <payment-methods-list></payment-methods-list>
            </uib-tab>
            @if (!isAdminv3)
            {
                <div class="js-not-tabs">
                    <ui-modal-trigger data-controller="'ModalAddPaymentMethodCtrl'" controller-as="ctrl"
                                      template-url="@Html.GetAssetPath("addPaymentMethod.html")"
                                      data-on-close="settings.paymentMethodsList.fetch()">
                        <button data-e2e="PaymentAdd" class="btn btn-sm btn-success" type="button">
                            <span class="fa fa-plus"></span> @T("Admin.Settings.Payments.PaymentMethods.AddPaymentMethod")
                        </button>
                    </ui-modal-trigger>
                </div>
            }
        </uib-tabset>
    </div>
}