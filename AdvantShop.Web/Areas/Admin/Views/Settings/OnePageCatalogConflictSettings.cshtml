@model AdvantShop.Web.Admin.ViewModels.Settings.OnePageCatalogConfictSettings
@{
        bool isMobile = SettingsDesign.IsMobileTemplate;
}

@if (Model.ShowSettingSearchBlockLocation)
{
        <div class="form-group setting__form-group">
                <div class="row middle-xs control-label @(isMobile ? "flex-nowrap" : "")">
                        <div class="col-xs-slim col-md-5 col-wl-4 @(isMobile ? "flex-shrink-1" : "")">
                                <label for="TurnOffSearchBlockLocation"
                                       class="setting__font-weight--xs">
                                        Поиск
                                </label>
                        </div>
                        <div class="relative col-xs-slim relative flex middle-xs first-xs last-md @(isMobile ? "p-r-xs" : "")">
                                <label class="adv-checkbox-label flex">
                                        @Html.CheckBoxFor(x => x.TurnOffSearchBlockLocation,
                                                new
                                                {
                                                        id = "TurnOffSearchBlockLocation", @class = "adv-checkbox-input input-alt-mobile",
                                                        ng_model = "$ctrl.data.TurnOffSearchBlockLocation"
                                                })
                                        <span class="adv-checkbox-emul"
                                              data-e2e="TurnOffSearchBlockLocation"></span>
                                </label>
                        </div>
                </div>
        </div>
}
