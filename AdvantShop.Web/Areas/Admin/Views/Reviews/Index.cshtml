@using AdvantShop.Core.Services.Admin
@model AdvantShop.Web.Admin.Models.Catalog.Reviews.ReviewsFilterModel

@{
    Html.AddAsset("reviews");

    var isMobile = SettingsDesign.IsMobileTemplate;


    if (AdminAreaTemplate.IsAdminv3() && !isMobile)
    {
        Layout = "~/Areas/Admin/Templates/" + AdminAreaTemplate.Current + "/Views/Catalog/_TopContentCatalogLayout.cshtml";
    }
}

@if (AdminAreaTemplate.IsAdminv3() && !isMobile)
{
    @section BlockAdditional {
        <ui-modal-trigger size="middle" data-controller="'ModalAddEditReviewCtrl'" controller-as="ctrl"
                          template-url="@Html.GetAssetPath("addEditReview.html")"
                          data-on-close="reviews.grid.fetchData()">
            <button class="btn btn-sm btn-success btn--margin-left" type="button" data-e2e="reviewAdd">
                <span class="fa fa-plus"></span>
                @T("Admin.Add") @T("Admin.Home.Menu.Reviews.Review")
            </button>
        </ui-modal-trigger>
    }
}

@if (isMobile)
{
    var headerModel = new AdvantShop.Web.Admin.ViewModels.Shared.Common.HeaderViewModel();
    headerModel.Title = "<span class=\"float-header-page\">" + T("Admin.Home.Menu.Reviews") + "</span>";
    headerModel.ShowOnlySticky = true;
    headerModel.Back = new AdvantShop.Web.Admin.ViewModels.Shared.Common.BackViewModel()
    {
        Url = Url.AbsoluteActionUrl("Index", "Catalog")
    };

    headerModel.Controls.Add(
        new ButtonModel()
        {
            Modificators = new List<eButtonModificators>()
       {
                eButtonModificators.OnlyIcon
                   },
            ColorType = eColorType.Secondary,
            Type = eButtonType.Add,
            WrapStart = " <ui-modal-trigger data-controller=\"'ModalAddEditReviewCtrl'\" controller-as=\"ctrl\" size=\"middle\" template-url=\"" + Html.GetAssetPath("addEditReview.html") + "\" data-on-close=\"reviews.grid.fetchData()\">",
            WrapEnd = "</ui-modal-trigger>",
            Icon = new ButtonIcon()
            {
                SvgName = "plus-alt",
                Attributes = new { width = 16, height = 16 },
            }
        }
   );

    @Html.Header(headerModel)
}
else
{
    <div class="sticky-page-name p-n" sticky sticky-top="0">
        <div class="page-name-block sticky-page-name-inner @(AdminAreaTemplate.IsAdminv3() ? "header-hidden" : null)">
            <div class="page-name-block-item-main">
                <h1 class="page-name-block-text sticky-page-name-text">
                    @T("Admin.Reviews.Index.Title")
                </h1>
            </div>
            <div class="page-name-block-item-additional">
                <ui-modal-trigger size="middle" data-controller="'ModalAddEditReviewCtrl'" controller-as="ctrl"
                                  template-url="@Html.GetAssetPath("addEditReview.html")"
                                  data-on-close="reviews.grid.fetchData()">
                    <button class="btn btn-sm btn-success btn--margin-left" type="button" data-e2e="reviewAdd">
                        <span class="fa fa-plus"></span>
                        @T("Admin.Add")
                    </button>
                </ui-modal-trigger>
            </div>
        </div>
    </div>
}

<div class="ibox">
    <div class="sticky-page-name @(isMobile ? "" : "m-t-n-xs m-t-n-sm")" sticky sticky-top="0">
        <div class="page-name-block sticky-page-name-inner @(isMobile ? "m-b-md" : "p-b-xs")">
            <div class="page-name-block-item-main flex middle-xs">
                @if (!isMobile)
                {
                    <h2 class="m-t-none m-b-none sticky-page-name-text m-r p-b-xs">@T("Admin.Home.Menu.Reviews")</h2>
                }

                @*<div class="flex middle-xs">
            <h2 class="m-b-lg">@T("Admin.Home.Menu.Reviews")</h2>*@

                <a href="@LinkService.Internal.AccountPlatform/help/pages/product-review" target="_blank" class="link-academy link-invert inline-flex middle-xs p-t-xs">
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 512 512" style="enable-background:new 0 0 512 512;" xml:space="preserve" width="18" height="18" fill="#989a9b" class="m-r-xs">
                    <path d="M20.005,512c-5.097,0-10.116-1.948-13.925-5.641c-5.845-5.666-7.672-14.309-4.621-21.855l45.411-112.333  C16.162,332.253,0,285.425,0,236c0-63.375,26.855-122.857,75.62-167.489C123.891,24.331,187.952,0,256,0  s132.109,24.331,180.38,68.511C485.145,113.143,512,172.625,512,236c0,45.448-14.04,89.577-40.602,127.615  c-6.325,9.057-18.792,11.271-27.849,4.947s-11.271-18.792-4.947-27.849C460.452,309.425,472,273.215,472,236  c0-108.075-96.897-196-216-196S40,127.925,40,236c0,43.783,15.577,85.2,45.046,119.773c4.834,5.671,6.115,13.561,3.321,20.47  l-31.366,77.589l91.345-40.266c5.063-2.231,10.826-2.267,15.916-0.095C193.082,425.766,223.946,432,256,432  c36.892,0,73.299-8.587,105.286-24.832c9.85-5,21.887-1.072,26.889,8.775c5.001,9.849,1.073,21.887-8.775,26.889  C341.828,461.914,299.157,472,256,472c-34.48,0-67.835-6.191-99.276-18.413L28.068,510.301C25.474,511.444,22.728,512,20.005,512z   M276,325V217c0-11.046-8.954-20-20-20s-20,8.954-20,20v108c0,11.046,8.954,20,20,20S276,336.046,276,325z M256,128  c-11.046,0-20,8.954-20,20l0,0c0,11.046,8.954,20,20,20s20-8.954,20-20l0,0C276,136.954,267.046,128,256,128z"></path>
                        </svg>
                    <span>@T("Admin.Home.Menu.Reviews.InstructionReviews")</span>
                </a>
            </div>
            <div class="page-name-block-item-main flex middle-xs">
                <a href="settingstemplate?settingsTemplateTab=product" target="_blank" class="link-decoration-none inline-flex middle-xs p-t-xs">
                    <span>@T("Admin.Home.Menu.Reviews.FeedbackSettings")</span>
                </a>
            </div>
        </div>
    </div>
    <div class="ibox-content">
        <ui-grid-custom grid-unique-id="grid"
                        grid-on-init="reviews.gridOnInit(grid)"
                        grid-options="reviews.gridOptions"
                        grid-url="'reviews/getreviews'"
                        grid-search-placeholder="'@T("Admin.Reviews.Index.SearchByAuthors")'"
                        @Html.Raw(Model.EntityId != 0 ? "grid-params='{entityId: " + Model.EntityId + "}'" : "")
                        grid-extend-ctrl="reviews"
                        grid-swipe-line="true">
             <ui-grid-custom-override-control class="ng-cloak">
                     <div class="card card--gap-row-sm card--break-all">
                         <div class="row m-b-md">
                             <div class="col-xs-7">
                                 <div class="m-b-xs setting__label">{{row.entity.Name}}</div>
                                 <div class="fs-sm">{{row.entity.Email}}</div>
                             </div>
                             <div class="col-xs-5 text-right">
                                 <div class="fs-xs m-b-xs">{{row.entity.AddDateFormatted}}</div>
                                 <div class="fs-xs" ng-style="{'color': row.entity.Checked ? 'green' : 'red'}">{{row.entity.Checked 
                                         ? ('Admin.Js.Reviews.Index.Verified'|translate)
                                         : ('Admin.Js.Reviews.Index.Unverified'|translate)}}</div>
                             </div>
                         </div>
                         <div class="m-b-md flex" ng-if="row.entity.ProductId != null">
                             <div class="setting__label flex-shrink-n">@T("Admin.Reviews.Index.Product") </div>
                             <div class="m-l-xs">{{row.entity.ProductName}}</div>
                         </div>
                         <div>
                             <div class="setting__label m-b-xs">@T("Admin.Home.Menu.Reviews.ReviewText")</div>
                             <div class="setting__text-overflow">{{row.entity.Text}}</div>
                         </div>
                     </div>
             </ui-grid-custom-override-control>
            <ui-grid-custom-footer class="ui-grid-custom-footer" ng-bind="reviews.grid.gridOptions.TotalString">
            </ui-grid-custom-footer>
        </ui-grid-custom>
    </div>
</div>
