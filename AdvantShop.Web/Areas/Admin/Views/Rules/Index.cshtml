 }
<div class="ibox">
    <div class="ibox-content">
        <ui-grid-custom grid-unique-id="grid"
                        grid-on-init="rules.gridOnInit(grid)"
                        grid-options="rules.gridOptions"
                        grid-url="'rules/getrules'"
                        grid-filter-enabled="false"
                        grid-swipe-line="true">
            <ui-grid-custom-override-control class="ng-cloak">
                <div class="card card--gap-row-sm">
                    <div class="flex middle-xs between-xs fs-xs">
                        <div class="m-r-md">{{row.entity.Name}}</div>
                        <div style="{{row.entity.Enabled ? 'color:green;' : 'color:red;white-space:nowrap;'}}">{{row.entity.Enabled ? 'Активно' : 'Не активно'}}</div>
                    </div>
                </div>
            </ui-grid-custom-override-control>
        </ui-grid-custom>
    </div>
</div>
