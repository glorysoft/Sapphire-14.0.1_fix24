@using AdvantShop.Core.Services.Admin
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    if (AdminAreaTemplate.Current != null)
    {
        Layout = "~/Areas/Admin/Templates/" + AdminAreaTemplate.Current + "/Views/Shared/_Layout.cshtml";
    }
    var showNewTriggerButton = !(Request.RawUrl.ToLower().Contains("edit") || Request.RawUrl.ToLower().Contains("emailings"));

    var isMobile = SettingsDesign.IsMobileTemplate;
}

@section TopContent {
    @if (!isMobile)
    {
        <div class="balance__padding-page balance__padding-page--bg-white">
            <div class="main-panel-page">
                <div class="p-b-n sticky-page-name">
                    <div class="page-name-block sticky-page-name-inner">
                        <div class="page-name-block-item-main">
                            <div class="flex middle-xs">
                                <h1 class="m-b-xs page-name-block-text page-name-block-text--bigger sticky-page-name-text">
                                    @T("Admin.Triggers.Index.Title")
                                </h1>
                                <div class="p-l-sm p-t-xs">
                                    <a class="inline-flex link-academy link-invert middle-xs" href="@LinkService.Internal.AccountPlatform/help/pages/triggernyi-marketing" target="_blank">
                                        <svg class="m-r-xs" fill="#989a9b" height="18" id="Layer_1" style="enable-background:new 0 0 512 512;" version="1.1" viewBox="0 0 512 512" width="18" x="0px" xml:space="preserve" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" y="0px">
                                            <path d="M20.005,512c-5.097,0-10.116-1.948-13.925-5.641c-5.845-5.666-7.672-14.309-4.621-21.855l45.411-112.333  C16.162,332.253,0,285.425,0,236c0-63.375,26.855-122.857,75.62-167.489C123.891,24.331,187.952,0,256,0  s132.109,24.331,180.38,68.511C485.145,113.143,512,172.625,512,236c0,45.448-14.04,89.577-40.602,127.615  c-6.325,9.057-18.792,11.271-27.849,4.947s-11.271-18.792-4.947-27.849C460.452,309.425,472,273.215,472,236  c0-108.075-96.897-196-216-196S40,127.925,40,236c0,43.783,15.577,85.2,45.046,119.773c4.834,5.671,6.115,13.561,3.321,20.47  l-31.366,77.589l91.345-40.266c5.063-2.231,10.826-2.267,15.916-0.095C193.082,425.766,223.946,432,256,432  c36.892,0,73.299-8.587,105.286-24.832c9.85-5,21.887-1.072,26.889,8.775c5.001,9.849,1.073,21.887-8.775,26.889  C341.828,461.914,299.157,472,256,472c-34.48,0-67.835-6.191-99.276-18.413L28.068,510.301C25.474,511.444,22.728,512,20.005,512z   M276,325V217c0-11.046-8.954-20-20-20s-20,8.954-20,20v108c0,11.046,8.954,20,20,20S276,336.046,276,325z M256,128  c-11.046,0-20,8.954-20,20l0,0c0,11.046,8.954,20,20,20s20-8.954,20-20l0,0C276,136.954,267.046,128,256,128z"/>
                                        </svg>
                                        <span>@T("Admin.Triggers.Index.InstructionsTriggerMarketing")</span>
                                    </a>
                                </div>
                            </div>
                            <div>
                                @T("Admin.Triggers.Index.Description")
                            </div>
                        </div>
                        @if (showNewTriggerButton)
                        {
                            <div class="page-name-block-item-additional">
                                <ui-modal-trigger controller-as="ctrl" data-controller="'ModalAddTriggerCtrl'"
                                                  template-url="@Html.GetAssetPath("addTrigger.html")">
                                    @{
                                        var disableAddition = Model.GetType().GetProperty("DisableAddition") != null ? Model.DisableAddition.ToString().ToLower() : "false";
                                    }
                                    <button class="btn btn-sm btn-success" data-e2e="AddTrigger" disabled ng-disabled="@disableAddition" type="button">
                                        <span class="fa fa-plus"></span>
                                        @T("Admin.Triggers.Index.NewTrigger")
                                    </button>
                                </ui-modal-trigger>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else if(isMobile && !(Request.RawUrl.ToLower().Contains("edit")))
    {
        var headerModel = new AdvantShop.Web.Admin.ViewModels.Shared.Common.HeaderViewModel();
        headerModel.ShowOnlySticky = true;
        headerModel.DefaultTitle = T("Admin.Triggers.Index.Title").ToString();
        headerModel.Back = new AdvantShop.Web.Admin.ViewModels.Shared.Common.BackViewModel()
        {
            Url = Url.AbsoluteActionUrl("Index", "Home"),
            NgBackTriggerCallback = "triggers.onSelectTab(null)"
        };

        headerModel.Controls.Add(
            new ButtonModel()
            {
                Modificators = new List<eButtonModificators>()
                {
                    eButtonModificators.OnlyIcon
                },
                ColorType = eColorType.Secondary,
                Type = eButtonType.Add,
                // Attributes = new[] { "ng-if=\"triggers.tabActiveIndex === 'triggers'\"" },
                WrapStart = " <ui-modal-trigger ng-if=\"triggers.tabActiveIndex === 'triggers'\" data-controller=\"'ModalAddTriggerCtrl'\" controller-as=\"ctrl\" size=\"middle\" template-url=\"../areas/admin/content/src/triggers/modal/addTrigger/addTrigger.html\">",
                WrapEnd = "</ui-modal-trigger>",
                Icon = new ButtonIcon()
                {
                    SvgName = "plus-alt",
                    Attributes = new {width = 16, height = 16},
                }
            }
            );

        headerModel.Controls.Add(
            new ButtonModel()
            {
                Modificators = new List<eButtonModificators>()
                {
                    eButtonModificators.OnlyIcon
                },
                ColorType = eColorType.Secondary,
                Type = eButtonType.Add,
                // Attributes = new[] { "ng-if=\"triggers.tabActiveIndex === 'categories'\"" },
                WrapStart = " <ui-modal-trigger ng-if=\"triggers.tabActiveIndex === 'categories'\" data-controller=\"'ModalAddEditCategoryCtrl'\" controller-as=\"ctrl\" size=\"middle\" data-on-close=\"triggers.grid.fetchData()\" template-url=\"../areas/admin/content/src/triggers/modal/addEditCategory/addEditCategoryTriggers.html\">",
                WrapEnd = "</ui-modal-trigger>",
                Icon = new ButtonIcon()
                {
                    SvgName = "plus-alt",
                    Attributes = new {width = 16, height = 16},
                }
            }
            );

        var moreButton = new MoreButtonModel();
        moreButton.ColorType = eColorType.Secondary;
        moreButton.NgTemplateId = "moreButtonHeaderTemplate";
        moreButton.Items = new List<MoreButtonPopoverItem>();

        moreButton.Items.Add(new MoreButtonPopoverItem()
        {
            Type = eButtonType.Link,
            ColorType = eColorType.Link,
            Modificators = new List<eButtonModificators>()
            {
                eButtonModificators.HorizontalPaddingZero
            },
            Attributes = new[] {"ng-click=\"triggers.deleteTriggers()\""},
            Text = T("Отключить канал"),
            Icon = new ButtonIcon()
            {
                SvgName = "on",
                Attributes = new {width = 24, height = 24}
            }
        });

        headerModel.Controls.Add(moreButton);

       @Html.Header(headerModel)
    }
}

@RenderBody()