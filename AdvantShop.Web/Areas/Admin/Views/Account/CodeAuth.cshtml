@model AdvantShop.Web.Admin.ViewModels.Shared.Account.CodeAuthViewModel
@{
    Layout = "~/Areas/Admin/Views/Account/_AccountLayout.cshtml";
}

@if (!Model.IsBanned)
{
<form class="admin-login-block__form" role="form" name="form" action="@Url.AbsoluteActionUrl("CodeAuthPost", "Account")" method="POST" novalidate>
    <div class="relative">
        <input type="text" minlength="6" maxlength="6" name="txtCode" id="txtCode" class="admin-signin-field auth-field" placeholder="Код" ng-model="error.code" required autofocus/>
    </div>
    @if (Model.CodeSent)
    {
    <div class="text-center m-b-md">
        @T("Admin.Account.CodeSentToEmail"): @Model.Login
    </div>
    }
    @if (Model.ShowCaptcha)
    {
    <div class="m-b-md auth-captcha">
        @Html.Action("Captcha", "Common", new { ngModel = "captcha", area = "" })
    </div>
    }
    <div class="row middle-xs">
        <div class="col-xs-12">
            <button type="submit" class="btn-auth btn-md" ng-disabled="form.txtCode.$invalid" ng-class="{'btn-disabled': form.txtCode.$invalid}">@T("Admin.Account.Enter")</button>
        </div>
    </div>
    <div class="text-right m-t-md">
        <a href="@Url.AbsoluteActionUrl("RestoreTotpCode", "Account")" class="forget-link">@T("Admin.Account.SendCodeByEmail")</a>
    </div>
</form>
}
else
{
    <div class="text-center m-b-md">
        @T("Admin.Account.AccessIsBlockedTooManyAttempts")
    </div>
}