@model AdvantShop.Web.Admin.Models.Settings.WarehouseSettings.WarehouseSettingsModel
@{
    var isMobile = SettingsDesign.IsMobileTemplate;
}

<div ng-controller="WarehouseGroupsCtrl as warehouseGroups" @Html.Raw(isMobile ? "ng-init=\"settingsWarehouses.warehouseGroups = warehouseGroups\"" : "")>
    @if (!isMobile)
    {
        <div class="sticky-page-name m-t-n-xs" sticky sticky-top="0">
            <div class="page-name-block sticky-page-name-inner">
                <div class="page-name-block-item-main flex middle-xs setting--flex-column">
                        <h2 class="sticky-page-name-text m-t-none setting--align-top setting__subtitle">
                            @T("Admin.Settings.WarehousesGroups.Title")
                        </h2>
               
                </div>
                <div class="page-name-block-item-additional">
                    @Html.Button(T("Admin.Settings.WarehousesGroups.AddWarehouseGroup"), eButtonType.Add, link: Url.AbsoluteActionUrl("Add", "WarehouseGroups"), icon: new ButtonIcon() { CssClass = "plus" })
                </div>
            </div>
        </div>
     }

    <div class="">
        <ui-grid-custom grid-unique-id="gridWarehouseGroups"
                        grid-on-init="warehouseGroups.gridOnInit(grid)"
                        grid-options="warehouseGroups.gridOptions"
                        grid-row-identificator="'Id'"
                        grid-url="'warehouseGroups/getWarehouseGroups'"
                        grid-inplace-url="'warehouseGroups/inplaceWarehouseGroup'"
                        grid-extend-ctrl="warehouseGroups"
                        grid-swipe-line="true">
            <ui-grid-custom-override-control class="ng-cloak">
                <div class="card card--gap-row-sm card--p-18" style="padding: 0">
                    <div class="flex between-xs center-xs">
                        <a ng-href="warehouseGroups/edit/{{row.entity.Id}}" 
                           class="flex-grow card__col m-r-xs card--p-18 link-decoration-none" style="color: inherit;">
                            <div>
                                {{row.entity.Name}}
                            </div>
                        </a>
                        <div class="card__col card__col--end setting--align-center card--p-18">
                            <ui-grid-custom-switch row="row"></ui-grid-custom-switch>
                        </div>
                    </div>
                </div>
            </ui-grid-custom-override-control>
        </ui-grid-custom>
    </div>
</div>

