@using AdvantShop.Core.Services.Admin
@{
    var isMobile = SettingsDesign.IsMobileTemplate;

    if (AdminAreaTemplate.IsAdminv3())
    {
        Layout = "~/Areas/Admin/Templates/" + AdminAreaTemplate.Current + "/Views/BonusSystem/_BonusSystemLayout.cshtml";
    }

    Html.AddAsset("cards");


    var headerModel = new AdvantShop.Web.Admin.ViewModels.Shared.Common.HeaderViewModel();
    headerModel.Title = "<span class=\"float-header-page\">" + T("Admin.Cards.Index.Title") + "</span>";
    headerModel.ShowOnlySticky = true;
    headerModel.EnabledBack = true;
    headerModel.Back = new AdvantShop.Web.Admin.ViewModels.Shared.Common.BackViewModel()
    {
        Url = Url.AbsoluteActionUrl("Index", "Bonus")
    };


    headerModel.Controls.Add(
       new ButtonModel()
       {
           Modificators = new List<eButtonModificators>()
      {
                eButtonModificators.OnlyIcon
                  },
           ColorType = eColorType.Secondary,
           Type = eButtonType.Add,
           WrapStart = " <ui-modal-trigger data-controller=\"'ModalAddCardCtrl'\" controller-as=\"ctrl\" size=\"middle\" template-url=\""+ Html.GetAssetPath("addcard.html") +"\">",
           WrapEnd = "</ui-modal-trigger>",
           Icon = new ButtonIcon()
           {
               SvgName = "plus-alt",
               Attributes = new { width = 16, height = 16 },
           }
       }
  );

    var moreButton = new MoreButtonModel();
    moreButton.ColorType = eColorType.Secondary;
    moreButton.NgTemplateId = "moreButtonHeaderTemplate";
    moreButton.Items = new List<MoreButtonPopoverItem>();

    moreButton.Items.Add(new MoreButtonPopoverItem()
    {
        Type = eButtonType.Link,
        ColorType = eColorType.Link,
        Modificators = new List<eButtonModificators>()
{
                            eButtonModificators.HorizontalPaddingZero
                        },
        WrapStart = "<ui-modal-trigger data-controller=\"'ModalImportCardsCtrl'\" controller-as=\"ctrl\" template-url=\""+ Html.GetAssetPath("importcards.html") + "\" on-close=\"cards.gridUpdate()\" on-dismiss=\"cards.gridUpdate()\">",
        WrapEnd = "</ui-modal-trigger>",
        Text = T("Admin.Cards.Index.ImportCards")
    });

    moreButton.Items.Add(new MoreButtonPopoverItem()
    {
        Type = eButtonType.Link,
        ColorType = eColorType.Link,
        Modificators = new List<eButtonModificators>()
{
                            eButtonModificators.HorizontalPaddingZero
                        },
        Attributes = new[] { "ng-click=\"cards.startExport()\"" },
        Text = T("Admin.Cards.Index.ExportCards")
    });

    moreButton.Items.Add(new MoreButtonPopoverItem()
    {
        Type = eButtonType.Link,
        ColorType = eColorType.Link,
        Modificators = new List<eButtonModificators>()
{
                            eButtonModificators.HorizontalPaddingZero
                        },
        WrapStart = "<ui-modal-trigger data-controller=\"'ModalAddBonusCtrl'\" controller-as=\"ctrl\" template-url=\"" + Html.GetAssetPath("addBonus.html") + "\" resolve=\"{params:{filter: cards.grid.selectionCustom.getSelectedParams(\'CardId\'), sendSms: false}}\">",
        WrapEnd = "</ui-modal-trigger>",
        Text = T("Admin.Cards.Index.AccrueBonuses")
    });

    headerModel.Controls.Add(moreButton);

    @Html.Header(headerModel)
}

@if (!isMobile) {
    @section BlockAdditional {
        @Html.Partial("~/Areas/Admin/Templates/AdminV3/Views/BonusSystem/_AnalyticsLink.cshtml")
    } 
}

<div class="sticky-page-name @(isMobile ? "m-b-md" : "m-t-n-xs m-b-xs")" sticky sticky-top="0">
    <div class="page-name-block sticky-page-name-inner">
        <div class="page-name-block-item-main flex middle-xs">
            @if (!isMobile)
            {
                <h2 class="m-r-xs  sticky-page-name-text m-t-none">
                    @T("Admin.Cards.Index.Title")
                </h2>
            }

            <a href="@LinkService.Internal.AccountPlatform/help/pages/active-client-shop" target="_blank" class="@(isMobile ? "" : "p-l-xs") link-academy link-invert inline-flex middle-xs">
                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" id="Layer_1" x="0px" y="0px" viewBox="0 0 512 512" style="enable-background:new 0 0 512 512;" xml:space="preserve" width="18" height="18" fill="#989a9b" class="m-r-xs">
                <path d="M20.005,512c-5.097,0-10.116-1.948-13.925-5.641c-5.845-5.666-7.672-14.309-4.621-21.855l45.411-112.333  C16.162,332.253,0,285.425,0,236c0-63.375,26.855-122.857,75.62-167.489C123.891,24.331,187.952,0,256,0  s132.109,24.331,180.38,68.511C485.145,113.143,512,172.625,512,236c0,45.448-14.04,89.577-40.602,127.615  c-6.325,9.057-18.792,11.271-27.849,4.947s-11.271-18.792-4.947-27.849C460.452,309.425,472,273.215,472,236  c0-108.075-96.897-196-216-196S40,127.925,40,236c0,43.783,15.577,85.2,45.046,119.773c4.834,5.671,6.115,13.561,3.321,20.47  l-31.366,77.589l91.345-40.266c5.063-2.231,10.826-2.267,15.916-0.095C193.082,425.766,223.946,432,256,432  c36.892,0,73.299-8.587,105.286-24.832c9.85-5,21.887-1.072,26.889,8.775c5.001,9.849,1.073,21.887-8.775,26.889  C341.828,461.914,299.157,472,256,472c-34.48,0-67.835-6.191-99.276-18.413L28.068,510.301C25.474,511.444,22.728,512,20.005,512z   M276,325V217c0-11.046-8.954-20-20-20s-20,8.954-20,20v108c0,11.046,8.954,20,20,20S276,336.046,276,325z M256,128  c-11.046,0-20,8.954-20,20l0,0c0,11.046,8.954,20,20,20s20-8.954,20-20l0,0C276,136.954,267.046,128,256,128z"></path>
                </svg>
                <span>@T("Admin.BonusSystem.Index.InstructionsBonusSystem")</span>
            </a>
        </div>
        @if (!isMobile)
        {
            <div>
                <div class="flex">
                    <div class="page-name-block-item-additional">
                        <ui-modal-trigger data-controller="'ModalImportCardsCtrl'" controller-as="ctrl" size="md" backdrop="static"
                                          template-url="@Html.GetAssetPath("importcards.html")" on-close="cards.gridUpdate()" on-dismiss="cards.gridUpdate()">
                            @*<a data-e2e="ImportCards" class="btn btn-sm btn-success btn--margin-left" href="">*@
                            <a data-e2e="ImportCards" class="btn btn-sm btn-link btn--margin-left" href="">

                                @T("Admin.Cards.Index.ImportCards")
                            </a>
                        </ui-modal-trigger>
                    </div>
                    <div class="page-name-block-item-additional">
                        <a data-e2e="ExportCards" class="btn btn-sm btn-link btn--margin-left" href="" ng-click="cards.startExport()">

                            @T("Admin.Cards.Index.ExportCards")
                        </a>
                    </div>

                    <div class="page-name-block-item-additional">
                        <ui-modal-trigger data-controller="'ModalAddBonusCtrl'" size="md" backdrop="static"
                                          template-url="@Html.GetAssetPath("addBonus.html")"
                                          resolve="{params:{filter: cards.grid.selectionCustom.getSelectedParams('CardId'), sendSms: false}}">
                            <a href="" class="btn btn-sm btn-success btn--margin-left">
                                <span class="fa fa-plus"></span>
                                @T("Admin.Cards.Index.AccrueBonuses")
                            </a>
                        </ui-modal-trigger>
                    </div>


                    <div class="page-name-block-item-additional">
                        <ui-modal-trigger data-controller="'ModalAddCardCtrl'" controller-as="ctrl" size="md" backdrop="static"
                                          template-url="@Html.GetAssetPath("addcard.html")">
                            <a data-e2e="AddCard" class="btn btn-sm btn-success btn--margin-left" href="">
                                <span class="fa fa-plus"></span>
                                @T("Admin.Cards.Index.AddCard")
                            </a>
                        </ui-modal-trigger>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

<div class="ibox">
    <div class="ibox-content">
        <ui-grid-custom grid-unique-id="grid"
                        grid-on-init="cards.gridOnInit(grid)"
                        grid-on-filter-init="cards.gridOnFilterInit(filter)"
                        grid-options="cards.gridOptions"
                        grid-url="'cards/getcards'"
                        grid-swipe-line="true">
            <ui-grid-custom-override-control class="ng-cloak">
                <div class="card card--gap-row-sm">
                    <div class="flex middle-xs between-xs fs-xs">
                        <div>№ карты : {{row.entity.CardNumber}}</div>
                        <div>Выдана : {{row.entity.CreatedFormatted}}</div>
                    </div>
                    <div class="m-t-md m-b-md">
                        <div>ФИО : {{row.entity.FIO}}</div>
                    </div>
                    <div class="flex middle-xs between-xs fs-xs">
                        <div>Грейд : {{row.entity.GradeName}}</div>
                        <div>Бонус : {{row.entity.GradePersent}}%</div>
                    </div>
                </div>
            </ui-grid-custom-override-control>
        </ui-grid-custom>
    </div>
</div>

