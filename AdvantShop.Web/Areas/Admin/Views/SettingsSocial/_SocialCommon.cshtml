<div class="setting-title">
    <h3 class="setting__subtitle">@T("Admin.Settings.Social.ShareButtons")</h3>
</div>


<div class="form-group row setting__form-group">
    @if (!isMobile)
    {
        <div class="col-xs-2">
            <div class="setting-label-wrap">
                @Html.LabelFor(x => x.SocialShareEnabled, 
                    T("Admin.Settings.Social.SocialShareEnabled"))
            </div>
        </div>
    }
    <div class="col-xs-12 col-md-6  @(isMobile ? "flex middle-xs" : "")">
        <label class="adv-checkbox-label @(isMobile ? "p-r-xs" : "")">
            @Html.CheckBoxFor(x => x.SocialShareEnabled, 
                new
                {
                    @class = "adv-checkbox-input", 
                    data_ng_init = "settingsSocial.SocialShareEnabled=" + Model.SocialShareEnabled.ToLowerString(), 
                    data_ng_model = "settingsSocial.SocialShareEnabled"
                })
            <span class="adv-checkbox-emul"></span>
        </label>
        @if (isMobile)
        {
            <div class=" col-xs">
                @Html.LabelFor(x => x.SocialShareEnabled, 
                    T("Admin.Settings.Social.SocialShareEnabled"), 
                    new
                    {
                        @class = ""
                    })
            </div>
        }
        <help-trigger class="ng-cloak m-l-xs" data-title="@T("Admin.Settings.Social.SocialShareEnabled")">
            @T("Admin.Settings.Social.SocialShareEnabledHint")
        </help-trigger>
    </div>
</div>


<div class="form-group row setting__form-group">
    <div class="col-xs-12 col-md-2">
        <div class="setting-label-wrap">
            @Html.LabelFor(x => x.SocialShareCustomCode, 
                T("Admin.Settings.Social.SocialShareCustomCode"), 
                new
                {
                    @class = "setting__label"
                })
        </div>
    </div>
    <div class="col-xs-12 col-md-6">
        @Html.TextAreaFor(x => x.SocialShareCustomCode, 
            new
            {
                @class = "form-control input-alt", 
                data_ng_model = "settingsSocial.SocialShareCustomCode"
            })
    </div>
</div>


<div class="form-group row setting__form-group">
    <div class="col-xs-12 col-md-8">
        <div class="adv-panel-info setting__mobile-adv-panel-info" style="display:flex;">
            <a href="@LinkService.Internal.AccountPlatformNotSecure/help/pages/change-social-code" target="_blank">
                @T("Admin.Settings.Social.ShareButtonsInstruction")
            </a>
        </div>
    </div>
</div>