@using AdvantShop.Core.Services.Catalog
@using AdvantShop.Customers;
@using AdvantShop.Orders
@using AdvantShop.Core.Services.Configuration.Settings

<div class="bottom-panel bottom-panel--theme-alternative">
    <div class="bottom-panel__menu-block bottom-panel__menu-block--theme-alternative">
        <div class="bottom-panel__menu-item bottom-panel__menu-item--cart">
            <a href="@Url.RouteUrl("Cart")"
               class="bottom-panel__btn bottom-panel__btn--theme-alternative
                                                                bottom-panel-btn-cart bottom-panel-btn-cart--theme-alternative  
                                                                btn btn-big btn-confirm btn-expander">
                <span class="bottom-panel-btn-cart__text bottom-panel-btn-cart__text--theme-alternative">
                    <span class="bottom-panel-btn-cart__icon bottom-panel-btn-cart__icon--theme-alternative bottom-panel-btn-cart__icon--cart">
                        <svg width="30" height="31" viewBox="0 0 22 23" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                                d="M3.88892 8.7334H18.1111L17.3692 16.8943C17.286 17.81 16.5182 18.5112 15.5988 18.5112H6.4013C5.48182 18.5112 4.71407 17.81 4.63082 16.8944L3.88892 8.7334Z"
                                fill="currentColor" stroke="currentColor" stroke-width="1.33333"
                                stroke-linejoin="round"/>
                            <path
                                d="M7.44434 10.5113V7.84462C7.44434 5.88094 9.03621 4.28906 10.9999 4.28906C12.9636 4.28906 14.5554 5.88094 14.5554 7.84462V10.5113"
                                stroke="currentColor" stroke-width="1.33333" stroke-linecap="round"/>
                            <path d="M10.28 17V11.45H9.32V10.33H11.58V17H10.28Z" fill="currentColor"/>
                        </svg>
                        <span
                            class="bottom-panel-btn-cart__icon-value bottom-panel-btn-cart__icon-value--theme-alternative cs-t-1"
                            data-cart-count
                            data-ng-bind-html="cartCount.getValue()">@ShoppingCartService.CurrentShoppingCart.TotalItems</span>
                    </span>
                    <span class="">@T("Cart.ShoppingCart.ShoppingCart")</span>
                </span>

                <span data-cart-count data-type="totalPrice"
                      data-ng-bind-html="cartCount.getValue()">@ShoppingCartService.CurrentShoppingCart.TotalPrice.FormatPrice()</span>

            </a>
        </div>
        <div class="bottom-panel__menu-item">
            <button data-catalog-modal-trigger="{onePageCatalog: @SettingsDesign.OnePageCatalog.ToLowerString()}"
                    type="button" class="btn btn-big btn-action bottom-panel__btn bottom-panel__btn--theme-alternative">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 16 16">
                    <path fill="currentColor" d="M7 4c0-.14 0-.209.008-.267a.85.85 0 0 1 .725-.725C7.79 3 7.86 3 8 3s.209 0 .267.008a.85.85 0 0 1 .725.725C9 3.79 9 3.86 9 4s0 .209-.008.267a.85.85 0 0 1-.725.725C8.21 5 8.14 5 8 5s-.209 0-.267-.008a.85.85 0 0 1-.725-.725C7 4.21 7 4.14 7 4m0 4c0-.14 0-.209.008-.267a.85.85 0 0 1 .725-.725C7.79 7 7.86 7 8 7s.209 0 .267.008a.85.85 0 0 1 .725.725C9 7.79 9 7.86 9 8s0 .209-.008.267a.85.85 0 0 1-.725.725C8.21 9 8.14 9 8 9s-.209 0-.267-.008a.85.85 0 0 1-.725-.725C7 8.21 7 8.14 7 8m0 4c0-.139 0-.209.008-.267a.85.85 0 0 1 .724-.724c.059-.008.128-.008.267-.008s.21 0 .267.008a.85.85 0 0 1 .724.724c.008.058.008.128.008.267s0 .209-.008.267a.85.85 0 0 1-.724.724c-.058.008-.128.008-.267.008s-.209 0-.267-.008a.85.85 0 0 1-.724-.724C7 12.209 7 12.139 7 12"/>
                </svg>
            </button>
        </div>
    </div>
</div>

