@using AdvantShop.Configuration
@model AdvantShop.Core.Services.Landing.Blocks.LpBlock

@if (Model.TryGetSetting("fb_enabled") == true)
{
    <a class="social social--facebook icon-lp-facebook" href="@Model.TryGetSetting("fb_url")" target="_blank">
        <span class="social__name lp-btn--primary">@Model.TryGetSetting("fb_text")</span>
    </a>
}
@if (Model.TryGetSetting("vk_enabled") == true)
{
    <a class="social social--vkontakte" href="@Model.TryGetSetting("vk_url")" target="_blank">
        <svg width="30" height="30" viewBox="0 0 40 40">
            <use xlink:href="./images/socials/socials.svg?v=2#vk"></use>
        </svg>
        <span class="social__name lp-btn--primary">@Model.TryGetSetting("vk_text")</span>
    </a>
}
@if (Model.TryGetSetting("whatsapp_enabled") == true)
{
    <a class="social social--whatsapp icon-lp-whatsapp" href="@LinkService.SocialMedia.WhatsApp/@(Model.TryGetSetting("whatsapp_number"))?text=@Html.Encode(Model.TryGetSetting("whatsapp_message"))" target="_blank">
        <span class="social__name lp-btn--primary">@Model.TryGetSetting("whatsapp_text")</span>
    </a>
}
@if (Model.TryGetSetting("instagram_enabled") == true)
