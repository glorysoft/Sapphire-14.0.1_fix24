@using System.Globalization
@using AdvantShop.Core.Services.Configuration.Settings
@model AdvantShop.ViewModel.News.NewsBlockViewModel
<!--noindex-->
<article class="block news-block" style="--news-block-item-width: calc(100% / @SettingsNews.NewsMainPageCount)">
    <header class="block-head">
        <h2 class="h2">@T("News.NewsBlock.NewsTitle")</h2>
        <div class="allNews">
            <a href="@Url.AbsoluteRouteUrl("NewsHome")" class="cs-l-2">@T("News.NewsBlock.AllNews")</a>
        </div>
    </header>
    <div class="block-content">
        <ul class="news-block-items">
            @foreach (var newsItem in Model.Items)
            {
                <li class="news-block-row cs-bg-4">
                    <div class="news-block-anno">
                        <a href="@Url.AbsoluteRouteUrl("News", new { url = newsItem.UrlPath })"
                           class="news-block-anno-link">@newsItem.Title</a>
                    </div>
                    <div class="news-block-date cs-t-3">
                        <time class="news-block-date-text news-block-date__inner"
                              datetime="@newsItem.AddingDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                            <span class="news-block-date__day">@newsItem.AddingDate.Day</span>
                            <span class="news-block-date__humanize">
                                <span
                                    class="news-block-date__month">@DateTimeFormatInfo.CurrentInfo.GetMonthName(newsItem.AddingDate.Month)</span><br/>
                                <span
                                    class="news-block-date__day-of-week">@DateTimeFormatInfo.CurrentInfo.GetDayName(newsItem.AddingDate.DayOfWeek)</span>
                                <span
                                    class="news-block-date__time">@newsItem.AddingDate.TimeOfDay.ToString("hh\\:mm")</span>
                            </span>
                        </time>
                    </div>
                    @if (newsItem.Picture.PhotoName.IsNotEmpty())
                    {
                        <div class="news-block-picture">
                            <a href="@Url.AbsoluteRouteUrl("News", new { url = newsItem.UrlPath })">
                                <img class="news-block-picture-obj" data-qazy data-src="@newsItem.Picture.ImageSrc()"
                                     width="@SettingsPictureSize.NewsImageWidth"
                                     height="@SettingsPictureSize.NewsImageHeight"
                                     alt="@newsItem.Title">
                            </a>
                        </div>
                    }
                </li>
            }
        </ul>
    </div>
</article>
<!--/noindex-->