@model List<AdvantShop.Catalog.Brand>
@{
    int brandCarouselVisibleCount = TemplateSettingsProvider.Items["BrandCarouselVisibleCount"].TryParseInt(5);
}
<div class="carousel-logo">
    <div class="h2 h-inline">@T("Brand.Index.BrandsHeader")</div>
    <div class="row">
        <div class="col-xs">
            <div class="carousel carousel-horizontal">
                <div class="carousel-logo-inner">
                    <div class="carousel-logo-list"
                         data-carousel=""
                         data-carousel-class="gallery-logo-slider"
                         data-prev-class="carousel-main-prev icon-left-circle-after"
                         data-next-class="carousel-main-next icon-right-circle-after"
                         data-stretch="true"
                         data-visible-max="@brandCarouselVisibleCount">
                        @{
                            var i = 0;
                        }
                        @foreach (var brand in @Model)
                        {
                            <div class="carousel-logo-item">
                                <a class="carousel-logo-link"
                                   href="@Url.RouteUrl("Brand", new { url = brand.UrlPath })">
                                    <span class="carousel-logo-image-wrap  cs-bg-4">
                                        <img
                                            @Html.Raw(i < 7 ? "src" : "src=\"data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7\" data-src")="@brand.BrandLogo.ImageSrc()"
                                                                                                                                                                        alt="@Html.Encode(brand.Name)"
                                                                                                                                                                        title="@Html.Encode(brand.Name)"
                                                                                                                                                                        width="@(SettingsPictureSize.BrandLogoWidth)"
                                                                                                                                                                        height="@(SettingsPictureSize.BrandLogoHeight)"/>
                                    </span>
                                    <span class="carousel-logo-name cs-t-1">@brand.Name</span>

                                </a>
                            </div>
                            i++;
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>