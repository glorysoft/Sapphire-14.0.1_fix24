@model AdvantShop.Models.Search.SearchBlockModel
@{
    var headerType = TemplateSettingsProvider.Items["Header"];
    var toggleShowInput = headerType == "Type2";
}
<!--noindex-->
<div class="@(SettingsDesign.SearchBlockLocation != SettingsDesign.eSearchBlockLocation.TopMenu ? "container-fluid" : "" ) 
            @("search-block-" + SettingsDesign.SearchBlockLocation.ToString().ToLower())">
    <form name="searchHeaderForm" class="row site-head-search-form" novalidate="novalidate" data-ng-controller="SearchBlockCtrl as searchBlock" data-ng-init="searchBlock.url='@Url.Action("Index", "search")'">
        <div class="col-xs-9 site-head-search-input-wrap @Html.Raw(toggleShowInput ? "ng-cloak": "")" 
             data-ng-init="searchBlock.form = searchHeaderForm" 
             @Html.Raw(toggleShowInput ? "data-ng-show=\"searchBlock.isShow\"": "")>
            <div class="site-head-site-head-search"
                 data-autocompleter
                 data-field="Name"
                 data-link-all="search"
                 data-apply-fn="searchBlock.aSubmut(value, obj)"
                 data-template-path="scripts/_common/autocompleter/templates/categoriesProducts.html"
                 data-request-url="search/autocomplete">
                <input class="input-big site-head-search-input"
                       data-autocompleter-input
                       type="search"
                       autocomplete="off"
                       value="@Model.Q"
                       placeholder="@T("Search.SearchBlock.SearchPlaceholder")"
                       name="q"
                       data-default-button="@(toggleShowInput ? "#searchHeaderSubmitHidden": "#searchHeaderSubmit")"
                       data-ng-model="searchBlock.search" />
            </div>
            @if (!string.IsNullOrEmpty(Model.ExampleText))
            {
                <div class="site-head-search-example cs-t-3">
                    @T("Search.SearchBlock.Example"): <a href="@Model.ExampleLink" class="link-dotted-invert cs-l-3">@Model.ExampleText</a>
                </div>
            }
        </div>
        <div class="col-xs-3 site-head-search-btn-wrap">
            <div class="site-head-search-col">
                <a href="javascript:void(0)" aria-label="@T("Search.SearchBlock.Find")" class="btn btn-submit btn-big btn-expander site-head-search-btn" 
                   id="searchHeaderSubmit"  title="@T("Search.SearchBlock.Find")"
                   data-ng-click="@Html.Raw(toggleShowInput ? "searchBlock.isShow = !searchBlock.isShow" : "searchBlock.submit(searchBlock.search, false)")">
                    <span class="icon-search-block icon-search-before @(!toggleShowInput ? "cs-t-1": "")"></span>
                    <span class="site-head-search-btn-text">@T("Search.SearchBlock.Find")</span>
                </a>
                @if (toggleShowInput)
                {
                    <button id="searchHeaderSubmitHidden" type="button" hidden data-ng-click="searchBlock.submit(searchBlock.search, false)"></button>    
                }
            </div>
        </div>
    </form>
</div>
<!--/noindex-->