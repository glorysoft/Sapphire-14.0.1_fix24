@using AdvantShop.Catalog
@using AdvantShop.Orders
@model AdvantShop.ViewModel.ProductDetails.ProductDetailsViewModel
@{
    Layout = null;
    var product = Model.Product;
    var offer = Model.Offer;
    var currentZone = AdvantShop.Repository.IpZoneContext.CurrentZone;
    var filterPhotosEnable = Model.Product.ProductPhotos.Any(x => x.ColorID.HasValue);

    var artNo = offer != null ? offer.ArtNo : product.ArtNo;
}

<div data-ng-controller="ProductCtrl as product">
    <div
        data-ng-init="product.loadData(@product.ProductId, @(Model.ColorId != null ? Model.ColorId.ToString() : "null"), @(Model.SizeId != null ? Model.SizeId.ToString() : "null"), @Model.HidePrice.ToLowerString(), @filterPhotosEnable.ToLowerString(), true)">
    </div>
    <div
        class="row product-card product-card--quickview @(Model.ProductPageAsQuickView ? "product-card--quickview-onepagecatalog" : "")">
        <div class="col-xs-12 col-sm-7  product-card-photos @(!Model.ShowRelatedProductInProductQuickView ? "product-card-photos--sticky": "")">
            @Html.Action("ProductPhotos", new { productModel = Model, enabledModalPreview = false })
        </div>
        <div class="col-xs-12 col-sm-5 product-card-info">
            <div class="product-card-info-inner">
                @if (offer != null)
                {
                    <div class="product-card-panel-float-right">
                        @Html.Action("CompareBlock", "Compare",
                            new
                            {
                                NgOfferId = "product.offerSelected.OfferId",
                                NgNameCallbackInit = "product.compareInit",
                                Mode = "productQuickView",
                                Checked = ShoppingCartService.CurrentCompare.Any(x => x.OfferId == offer.OfferId), OfferId = offer.OfferId,
                                OnlyIcon = true,
                                PopoverText = String.Format("<a class=\"cs-l-2\" href=\"{0}\">{1}</a>", Url.AbsoluteRouteUrl("compare"), T("Compare.CompareName"))
                            })
                        @Html.Action("WishListBlock", "Wishlist", new
                        {
                            OfferId = offer.OfferId,
                            NgOfferId = "product.offerSelected.OfferId",
                            NgNameCallbackInit = "product.wishlistControlInit",
                            Mode = "productQuickView",
                            Checked = ShoppingCartService.CurrentWishlist.Any(x => x.OfferId == offer.OfferId),
                            OnlyIcon = true,
                            PopoverText = String.Format("<a class=\"cs-l-2\" href=\"{0}\">{1}</a>", Url.AbsoluteRouteUrl("wishlist"), T("Common.ToolBarBottom.Wishlist"))
                        })
                    </div>
                }
                @if (SettingsCatalog.ShowProductArtNoOnProductCard)
                {
                <div class="details-sku">
                    <div class="details-param-name">@T("Product.ProductInfo.Sku"):</div>

                    <div class="details-param-value inplace-offset"
                         data-ng-bind="product.offerSelected.ArtNo"
                         data-ng-init="product.offerSelected.ArtNo = '@artNo'">
                        @artNo
                    </div>
                    @if (!product.ExportOptions.Adult)
                    {
                    if (!string.IsNullOrEmpty(product.ExportOptions.Mpn))
                    {
                    <meta itemprop="mpn" content="@product.ExportOptions.Mpn"/>
                    }

                    <meta itemprop="sku" content="@artNo"/>
                    }
                    @if (!string.IsNullOrEmpty(product.ExportOptions.Gtin))
                    {
                    <meta itemprop="gtin" content="@product.ExportOptions.Gtin"/>
                    }
                </div>
                }
                <div class="page-title-row details-title-row">
                    <div class="details-title page-title h2">
                        @if (Model.ProductPageAsQuickView)
                        {
                            <span>@Html.GetPageH1()</span>
                        }
                        else
                        {
                            <a href="@Url.AbsoluteRouteUrl("Product", new { url = product.UrlPath })"
                               data-ng-href="{{product.getUrl('@Url.AbsoluteRouteUrl("Product", new { url = product.UrlPath })')}}">
                                @Html.GetPageH1()
                            </a>
                        }
                    </div>
                </div>
                @if (product.Brand != null && product.Brand.Enabled && product.Brand.BrandLogo != null && product.Brand.BrandLogo.PhotoName.IsNotEmpty())
                {
                    <figure class="details-brand fr">
                        <a href="@Url.RouteUrl("Brand", new { url = product.Brand.UrlPath })" class="details-brand-link">
                            <img class="details-brand-link" src="@product.Brand.BrandLogo.ImageSrc()"
                                 alt="@Html.Encode(product.Brand.Name)"/>
                        </a>
                    </figure>
                }
                @Html.Partial("ProductInfo", Model)
                <div>
                    @Html.StaticBlock("details-2")
                    @Html.RenderModules("product_middle", new { product, offer })
                    @if (Model.ShowTabsInProductQuickView)
                    {
                        @Html.Action("ProductTabs", Model)
                    }
                    @Html.StaticBlock("details-after-tabs")
                </div>
                <aside class="details-aside">
                    @Html.StaticBlock("bannerDetails")
                    @if (offer != null)
                    {
                        <div class="cs-bg-4 block-exuding">
                            @if (Model.RenderShippings && Model.ShowShippingsInProductQuickView)
                            {
                                <div class="block-exuding-row details-shipping">
                                    <div class="top-shipping-row">
                                        @T("Product.Index.ShippingTo")
                                        <a class="link-dotted-invert zone-dialog-trigger-link" href="javascript:void(0)"
                                           role="link" data-zone-dialog-trigger>
                                            <span data-zone-current
                                                  data-ng-bind="zone.City || '@T("Product.Index.ShippingTo.ChooseCity")'"
                                                  data-start-val="{City: '@currentZone.City'}">
                                                @currentZone.City
                                            </span>
                                        </a>
                                    </div>
                                    @{
                                        var prodMinAmount = product.GetMinAmount();
                                    }
                                    <div data-shipping-variants
                                         data-type="@Model.ShowShippingsMethods"
                                         data-start-offer-id="@offer.OfferId"
                                         data-start-amount="@prodMinAmount"
                                         data-offer-id="product.offerSelected.OfferId"
                                         data-amount="product.offerSelected.AmountBuy"
                                         data-sv-custom-options="product.customOptions.xml"
                                         data-zip="@currentZone.Zip"
                                         data-init-fn="product.addShippingVariants(shippingVariants)"
                                         class="details-shipping__shipping-variants">
                                    </div>
                                </div>
                            }
                            @Html.Action("SocialButtons", "Common")
                        </div>
                        @Html.RenderModules("product_right", new { product, offer })
                    }

                    <div class="flex center-xs">
                        @if (!Model.ProductPageAsQuickView)
                        {
                            <a href="@Url.AbsoluteRouteUrl("Product", new { url = product.UrlPath })"
                               data-ng-href="{{product.getUrl('@Url.AbsoluteRouteUrl("Product", new { url = product.UrlPath })')}}">
                                @T("Product.ProductProperties.GoToProperties")
                            </a>
                        }
                    </div>
                </aside>
            </div>
        </div>
        @if (Model.ShowRelatedProductInProductQuickView)
        {
            <div class="col-xs-12">
                <div class="details-row">
                    @Html.Action("RelatedProducts", new { Model.Product, type = RelatedType.Related })
                </div>
                <div class="details-row">
                    @Html.Action("RelatedProducts", new { Product = product, type = RelatedType.Alternative })
                </div>
            </div>
        }
    </div>
</div>