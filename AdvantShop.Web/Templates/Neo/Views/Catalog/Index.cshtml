@using AdvantShop.Customers
@using AdvantShop.SEO
@using AdvantShop.Catalog
@model AdvantShop.ViewModel.Catalog.CategoryViewModel
@{
    Html.AddAsset("catalog");
}
@{
    var category = Model.Category;
    var tag = Model.Tag;
    var briefDescription = tag != null ? tag.BriefDescription : category.GetCategoryBriefDescriptionFormatted();
    var description = tag != null ? tag.Description : category.GetCategoryDescriptionFormatted();
    var inplaceTag = tag != null ? Html.InplaceMeta(tag.Id, MetaType.Tag) : Html.InplaceMeta(category.CategoryId, MetaType.Category);
    var editLink = CustomerContext.CurrentCustomer.CustomerRole == Role.Administrator ||
                   (CustomerContext.CurrentCustomer.CustomerRole == Role.Moderator && CustomerContext.CurrentCustomer.HasRoleAction(RoleAction.Catalog));
    var isShowDeliveryWidget = TemplateSettingsProvider.GetSettingValue("ShowDeliveryWidgetOnAllPages").TryParseBool();
    string catalogFilterMode = TemplateSettingsProvider.GetSettingValue("CatalogFilterMode");
}
@if (isShowDeliveryWidget)
{
    @Html.Action("GeoMode", "Home", new { area = "" })
}
<div class="row catalog-container catalog-container--@(catalogFilterMode == "Default" ? "two-columns": "one-columns")">
    @if (category.Picture != null && category.Picture.PhotoName.IsNotEmpty())
    {
        <div class="category-picture">
            <img src="@category.Picture.ImageSrcBig()" alt="@category.Picture.Alt"
                 width="@SettingsPictureSize.BigCategoryImageWidth" height="@SettingsPictureSize.BigCategoryImageHeight"
                 title="@category.Picture.Title" />
        </div>
    }
    @if (catalogFilterMode == "Default")
    {
        <div class="col-p-v site-body-aside catalog-left-column" data-set-css-custom-props="{'catalog-left-column-width': 'width'}">
            @Html.Action("MenuCatalog", "Catalog", new { InLayout = false, IsExpanded = true, CategoryId = category.CategoryId })
            @if (Model.Filter != null && SettingsDesign.FilterVisibility)
            {
                <div data-catalog-filter data-url="catalog/filter"
                     data-url-count="catalog/filterproductCount"
                     data-found-count="@Model.Pager.TotalItemsCount"
                     data-parameters="{categoryId : @(category.CategoryId), tagUrl: '@Model.TagView.Tags.Where(x => x.Selected).Select(x => x.Url).FirstOrDefault()'}"
                     data-count-visible-collapse="10"></div>
            }
            @Html.StaticBlock("CatalogLeft")
        </div>
    }
    <div class="col-p-v site-body-main catalog-right-column">
        <div class="page-title-row catalog-title-row">
            <div class="catalog-title page-title">
                <h1 @(inplaceTag)>
                    @Html.GetPageH1()
                </h1>
            </div>
        </div>
        @Html.Action("BreadCrumbs", "Common", new { Model.BreadCrumbs })
        @if (editLink)
        {
            <div class="m-b-sm">
                <a target="_blank"
                   href="@UrlService.GetUrl("adminv2/category/edit/" + category.CategoryId)">@T("Catalog.Index.EditInAdminArea")</a>
            </div>
        }
        @if ((!string.IsNullOrWhiteSpace(briefDescription) || InplaceEditorService.CanUseInplace(RoleAction.Catalog)) && Model.Pager.CurrentPage == 1)
        {
            <div class="category-description"
                 @(tag == null ? Html.InplaceCategory(category.CategoryId, CategoryInplaceField.BriefDescription) : Html.InplaceTag(tag.Id, TagInplaceField.BriefDescription))>
                @Html.Raw(briefDescription)
            </div>
        }

        
        <div class="col-xs">
            @Html.Action("CategoryList", "Catalog", new { categoryId = category.CategoryId, type = category.DisplayStyle })
        </div>

        @Html.RenderModules("category_top", category)

        @Html.Partial("_TagView", Model.TagView)

        @if (Model.HasProducts)
        {
            <div class="row middle-xs m-b-lg">
                <div class="col-xs">
                    <div class="catalog-sorting">
                        @if (catalogFilterMode == "Sidebar" && Model.Filter != null && SettingsDesign.FilterVisibility)
                        {
                            <div data-ng-controller="FilterSidebarController as filterSidebar">


                                <script type="text/ng-template" id="sidebarFilter">
                                       <div data-catalog-filter data-url="catalog/filter"
                                                 data-url-count="catalog/filterproductCount"
                                                 data-found-count="@Model.Pager.TotalItemsCount"
                                                 data-parameters="{categoryId : @(category.CategoryId), tagUrl: '@Model.TagView.Tags.Where(x => x.Selected).Select(x => x.Url).FirstOrDefault()'}"
                                                 data-count-visible-collapse="10"></div>
                                </script>
                                <button type="button"
                                        class="catalog-filter-trigger"
                                        data-ng-click="filterSidebar.toggleFilter($event)"
                                        data-sidebar-container-state="sidebarFilter">
                                    <svg style="width:24px; margin-right: var(--adv-m-base)" viewBox="0 0 20 18">
                                        <path fill-rule="evenodd" stroke="none"
                                              d="M19.5 14.623h-3.94a3.124 3.124 0 0 1-6.12 0H.5v-1.245h8.94a3.124 3.124 0 0 1 6.12 0h3.94v1.245ZM10.622 14a1.878 1.878 0 1 0 3.755 0 1.878 1.878 0 0 0-3.755 0Z"
                                              clip-rule="evenodd"></path>
                                        <path fill-rule="evenodd" stroke="none"
                                              d="M.5 4.623V3.378h3.94a3.124 3.124 0 0 1 6.12 0h8.94v1.245h-8.94a3.124 3.124 0 0 1-6.12 0H.5ZM5.622 4a1.878 1.878 0 1 0 3.755 0 1.878 1.878 0 0 0-3.755 0Z"
                                              clip-rule="evenodd"></path>
                                    </svg>
                                    <span>@T("Js.CatalogFilter.Filters")</span>
                                </button>
                            </div>
                        }
                        @Html.Partial("Sorting", Model.Filter)
                    </div>
                </div>
                @if (Model.Filter.AllowChangeViewMode)
                {
                    <div class="col-xs-slim flex middle-xs products-view-variants-wrap end-xs">
                        @Html.Action("ChangeMode", "Catalog", new { name = "productViewCatalog", viewMode = Model.Filter.ViewMode })
                    </div>
                }
            </div>
            <div class="row products-view products-view-@Model.Filter.ViewMode" data-product-view-mode
                 data-name="productViewCatalog" data-current="@Model.Filter.ViewMode">
                @Html.Partial("_ProductView", Model.Products)
            </div>
            @Html.Paging(Model.Pager)
            <div class="products-view-sort-result">
                <span class="products-view-sort-result-text cs-t-3">@T("Catalog.Index.ItemsFound")</span>
                <span class="products-view-sort-result-number">@Model.Pager.TotalItemsCount</span>
            </div>
        }
        else if (Model.Filter != null && Model.Filter.IsApplied)
        {
            <div>@T("Search.Index.NothingFound")</div>
        }
        @Html.RenderModules("category_bottom", category)
        @if ((!string.IsNullOrWhiteSpace(description) || InplaceEditorService.CanUseInplace(RoleAction.Catalog)) && Model.Pager.CurrentPage == 1)
        {
            <div class="category-description"
                 @(tag == null ? Html.InplaceCategory(category.CategoryId, CategoryInplaceField.Description) : Html.InplaceTag(tag.Id, TagInplaceField.Description))>
                @Html.Raw(description)
            </div>
        }
        @Html.StaticBlock("CatalogRightBottom")
    </div>
</div>