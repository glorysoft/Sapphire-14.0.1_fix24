@using AdvantShop.Catalog
@using AdvantShop.Core.Services.Configuration.Settings
@model AdvantShop.ViewModel.Catalog.CategoryListViewModel

@{
    bool showCategoryPhoto = TemplateSettingsProvider.Items["ShowCategoryPhoto"].TryParseBool();
    string _productCardBackground = TemplateSettingsProvider.Items["ProductCardBackground"];
	string productCardBackground = showCategoryPhoto ? _productCardBackground : "productcard";
}

@if (Model.DisplayStyle == ECategoryDisplayStyle.List)
{
    if (Model.Categories.Count > 0)
    {
        <div class="catalog-list">
            @foreach (var category in Model.Categories)
            {
                <a class="panel cs-l-1 cs-br-1 inked ink-dark catalog-product-item catalog-product-item--fill-@(productCardBackground.ToLower())" href="@Url.AbsoluteRouteUrl("Category", new {url = category.UrlPath})">
                    @if (category.MiniPicture.PhotoName.IsNotEmpty())
                    {
                        <div class="prod-photo" style="height: @(SettingsMobile.BlockProductPhotoHeight)px">
                            <img data-qazy src="@category.MiniPicture.ImageSrcSmall()" alt="@Html.AttributeEncode(category.Name)" width="@(Model.PhotoWidth)" height="@(SettingsMobile.BlockProductPhotoHeight)" />
                        </div>
                    }
                    <div class="prod-text">
                        <div class="prod-name text-floating">
                            @Html.Raw(category.Name)
                            @if (Model.DisplayProductCount)
                            {
                                @("(" + category.ProductsCount + ") ")
                            }
                        </div>

                    </div>

                </a>
            }
        </div>
    }
}
else if (Model.DisplayStyle == ECategoryDisplayStyle.Tile)
{
    var i = 0;
    <table class="catalog-view-table">
        @foreach (var category in Model.Categories)
        {
            if (i % 2 == 0)
            {
                @:<tr>
                }
                <td class="cat-cell catalog-product-item--fill-@(productCardBackground.ToLower())">
                    <a class="inked ink-dark" href="@Url.AbsoluteRouteUrl("Category", new {url = category.UrlPath})">
                        @if (showCategoryPhoto && category.MiniPicture.PhotoName.IsNotEmpty())
                        {
                            <div class="cat-image-wrap" style="height: @(SettingsMobile.BlockProductPhotoHeight)px">
                                <img data-qazy src="@category.MiniPicture.ImageSrcSmall()" alt="@category.MiniPicture.Alt" width="@(Model.PhotoWidth)" 
                                     height="@(SettingsMobile.BlockProductPhotoHeight)" title="@category.MiniPicture.Title" />
                            </div>
                        }
                        <div class="cat-name">@Html.Raw(category.Name)</div>
                        @if (Model.DisplayProductCount)
                        {
                            <div class="goods-count cs-t-1">@category.ProductsCount</div>
                        }
                    </a>
                </td>
                if (i != 0 && i % 2 != 0)
                {
                @:</tr>
            }
            i++;
        }
    </table>
}