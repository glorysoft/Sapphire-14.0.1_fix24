@model string

<div class="text-align-right">
    <button type="button" class="view-mode-trigger ng-hide" data-ng-show="changeMode.isReadyViewMode" data-product-view-change-mode data-name="mobileModern" data-view-list-name="mobileModern" data-ng-click="changeMode.toggle('productViewMobile')" data-is-mobile="true" data-default-view-mode="@Model">
        <span data-ng-switch="changeMode.current">
            <svg data-ng-switch-when="tile"
                 width="24" height="24"  viewBox="0 0 24 24" fill="none" >
					<rect x="3.5" y="4" width="7" height="7" rx="2.5" stroke="black" stroke-width="1.5"/>
					<rect x="3.5" y="14" width="7" height="7" rx="2.5" stroke="black" stroke-width="1.5"/>
					<rect x="13.5" y="4" width="7" height="7" rx="2.5" stroke="black" stroke-width="1.5"/>
					<rect x="13.5" y="14" width="7" height="7" rx="2.5" stroke="black" stroke-width="1.5"/>
            </svg>

            <svg data-ng-switch-when="list"
                 width="24" height="24" viewBox="0 0 24 24" fill="none">
					<rect x="3.5" y="4" width="7" height="7" rx="2.5" stroke="black" stroke-width="1.5"/>
					<rect x="3.5" y="14" width="7" height="7" rx="2.5" stroke="black" stroke-width="1.5"/>
					<path d="M14 7L21 7" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
					<path d="M14 17L21 17" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
            </svg>

            <svg data-ng-switch-when="single"
                 width="24" height="24" viewBox="0 0 24 24" fill="none">
				<path d="M3 7L21 7" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
				<path d="M3 17L21 17" stroke="black" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </span>
    </button>
</div>
