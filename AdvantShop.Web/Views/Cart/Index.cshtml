@model AdvantShop.ViewModel.Cart.CartViewModel
@{
    Html.AddAsset("cart");
}

<div class="col-p-v cart cart-page">
    <div class="cart-title page-title">
        <div class="row between-xs m-b-md middle-xs">
            <h1 class="m-b-none col-xs">
                @T("Cart.Index.ShoppingCart")
            </h1>
            <div ng-if="cartPage.cartData != null && cartPage.cartData.CartProducts.length > 0" class="col-xs-slim">
                <div class="cart-page__cart-btns-wrap">
                    <button type="button" data-clear-cart="" data-ng-click="cartFull.clear($event)"
                            title="@T("Js.Cart.ClearBasket")"
                            class="btn btn-small btn-icon btn-action btn--two-column cart-clear-btn">
                    </button>
                    <button type="button" class="btn btn-icon btn-small btn-submit btn--two-column cart-share-btn"
                            title="@T("Cart.Index.ShoppingCart.Share")"
                            data-ng-click="cartPage.getUrlShareCart()" data-uib-tooltip-template="'@Html.GetAssetPath("urlShare.html")'"
                            data-tooltip-trigger="'click'" data-tooltip-class="cart-page__url-share"
                            data-tooltip-placement="bottom-right">
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div data-module data-key="fullcartmessage" class="fullcartmessage">
        @Html.RenderModules("fullcartmessage")
    </div>
    @if (Model.ShowPriceAmountNextDiscountsInCart)
    {
        <div data-price-amount-cart></div>
    }
    <div class="row">
        <div class="col-xs">
            <div data-cart-full data-photo-width="@Model.PhotoWidth"
                 data-link-as-quickview="@SettingsDesign.OnePageCatalog.ToLowerString()"></div>
        </div>
        @Html.RenderModules("cart_right_column")
    </div>

    @Html.StaticBlock("shoppingcart")
    @Html.RenderModules("shoppingcart")

    @if (Model.IsDemo)
    {
        <div class="cart-full-error">@T("Cart.Index.FakeShop")</div>
    }

    @Html.RenderModules("shoppingcart_after")
</div>

