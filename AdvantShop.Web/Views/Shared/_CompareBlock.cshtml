@model CompareViewModel
@{
    var popoverTrigger = Model.PopoverText.IsNotEmpty() ? "data-ng-mouseenter=\"compare.popoverIsOpen = true\" data-ng-mouseleave=\"compare.popoverIsOpen = false\"" : string.Empty;
    var popover =  Model.PopoverText.IsNotEmpty() ? "data-uib-popover-html=\"'" + Html.AttributeEncode(Model.PopoverText) + "'\" data-popover-is-open=\"compare.popoverIsOpen\" data-popover-trigger=\"'none'\" data-popover-placement=\"left\" data-popover-append-to-body=\"false\"" : string.Empty;
}
@if (Model.Mode == "product")
{
    @:<div class="block-exuding-row details-compare">
}
<div  data-compare-control="@Model.NgOfferId" class="compare-control-wrap" @Html.Raw(popoverTrigger)>
    <label class="compare-control @(Model.CssClass.IsNotEmpty() ? Model.CssClass : string.Empty)"
           data-ng-class="{'compare-state-add cs-l-1': compare.isAdded, 'compare-state-not-add cs-l-2': !compare.isAdded}"
           @Html.Raw(popover)>
        <input type="checkbox"
               class="custom-input-native compare-checkbox"
               aria-label="@(Model.Checked ? T("Compare.CompareBlock.InComparison") : T("Compare.CompareBlock.AddToComparison"))"
               data-ng-attr-aria-label="{{compare.isAdded ? '@T("Compare.CompareBlock.InComparison")' : '@T("Compare.CompareBlock.AddToComparison")'}}"
               data-ng-init="compare.isAdded = @Model.Checked.ToLowerString(); @(Model.NgNameCallbackInit != null ? Model.NgNameCallbackInit + "(compare)" : "")"
               data-ng-model="compare.isAdded"
               data-ng-change="compare.change(@Model.NgOfferId, compare.isAdded)"/>
        <span class="icon-menu-after compare-control__icon"></span>
        @if (Model.OnlyIcon == false)
        {
            <span class="custom-input-text">
                @*change text to css*@
                <span class="compare-text-not-added">@T("Compare.CompareBlock.AddToComparison")</span>
                <span class="compare-text-added">@T("Compare.CompareBlock.InComparison") (<a href="@Url.AbsoluteRouteUrl("compare")">@T("Compare.CompareBlock.GoToComparison")</a>)</span>
            </span>
        }
    </label>
</div>
@if (Model.Mode == "product")
{
    @:</div>
}