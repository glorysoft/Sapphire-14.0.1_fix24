@model AdvantShop.Models.User.RecoveryPasswordModel

@{
    Html.AddAsset("recoveryPassword");
}

@{
    var isLanding = Model.LpId != null;
    if (isLanding)
    {
        Layout = "~/Areas/Landing/Views/Shared/_Layout.cshtml";
    }
}

@if (isLanding)
{
    @:<div class="lp-main">
}

<div class="forgot-container @(isLanding ? "container-fluid" : "")">
    <div class="col-p-v-desktop @(isLanding ? "lp-container" : "")"
         data-ng-controller="RecoveryPasswordCtrl as recoveryPassword">
        <div class="@(isLanding ? "row center-xs text-left": "")">
            <div class="@(isLanding ? "col-xs-12 col-md-6": "")">
                <div class="forgot-container__title-breadcrumbs-wrap">
                    <div class="page-title">
                        <h1 class="forgot-title main-title main-title--m-t-n cs-bg-4--mobile">
                            @T("User.ForgotPassword.Header")
                        </h1>
                    </div>
                    @if (!isLanding)
                    {
                        @Html.SingleBreadCrumb(T("User.ForgotPassword.Header").ToString())
                    }
                </div>
                <div ng-init="recoveryPassword.init(@(Model.LpId != null && Model.LpId != 0 ? Model.LpId.ToString() : "null"), '@Model.Email', '@Model.RecoveryCode')"
                     ng-switch="recoveryPassword.view"
                     class="ng-cloak mobile-container-fluid">
                    <div ng-switch-when="recovery">
                        <form name="authForm" 
                              novalidate="novalidate">
                            <div class="form-legend">
                                @T("User.ForgotPassword.ChangePassword")
                            </div>
                            <label class="row middle-xs">
                                <span class="col-xs-12 @(!isLanding ? "col-sm-2" : "col-sm-4")">
                                    <span class="form-field-name vertical-interval-xsmall">
                                        @T("MyAccount.ChangePassword.NewPassword")
                                    </span>
                                </span>
                                <span class="col-xs-12 @(!isLanding ? "col-sm-4" : "col-sm-8")">
                                    <span class="form-field-input vertical-interval-xsmall">
                                        @Html.Password("newPassword", null, 
                                        new
                                        {
                                            autocomplete = "off", 
                                            @class = "input-small", 
                                            data_ng_model = "recoveryPassword.newPassword"
                                        })
                                    </span>
                                </span>
                            </label>
                            <label class="row middle-xs">
                                <span class="col-xs-12 @(!isLanding ? "col-sm-2" : "col-sm-4")">
                                    <span class="form-field-name vertical-interval-xsmall">
                                        @T("MyAccount.ChangePassword.NewPasswordConfirm")
                                    </span>
                                </span>
                                <span class="col-xs-12 @(!isLanding ? "col-sm-4" : "col-sm-8")">
                                    <span class="form-field-input vertical-interval-xsmall">
                                        @Html.Password("newPasswordConfirm", null, 
                                        new
                                        {
                                            autocomplete = "off", 
                                            @class = "input-small", 
                                            data_ng_model = "recoveryPassword.newPasswordConfirm"
                                        })
                                    </span>
                                </span>
                            </label>
                            <div class="row middle-xs">
                                <span class="col-xs-12 @(!isLanding ? "col-sm-2 col-sm-offset-2" : "col-sm-8 col-sm-offset-4")">
                                    <span class="form-field-input vertical-interval-xsmall">
                                        <a href="javascript:void(0)"
                                           class="btn btn-middle btn-action"
                                           data-button-validation
                                           data-ng-click="recoveryPassword.submitRecover()">
                                            @T("User.ForgotPassword.ChangePassword")
                                        </a>
                                    </span>
                                </span>
                            </div>
                        </form>
                    </div>

                    <div ng-switch-when="recoverySuccess">
                        <div class="h2">@T("User.ForgotPassword.PasswordChanged")</div>
                        @if (!isLanding)
                        {
                            <div>
                                <a href="@Url.AbsoluteRouteUrl("Home")">
                                    @T("User.ForgotPassword.ToMainPage")
                                </a>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@if (isLanding)
{
    @:</div>
}