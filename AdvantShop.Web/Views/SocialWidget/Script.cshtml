@using AdvantShop.Core.Services.Configuration.Settings
@using AdvantShop.FilePath
@using AdvantShop.Helpers
@model AdvantShop.Models.SocialWidgets.SocialWidgetModel
@{
    var oneActive = Model.ActiveCount == 1;
    var isMobile = SettingsDesign.IsMobileTemplate;
}

@if (Model.ShowPoppover)
{
    @* не перемещать!!!!! *@
    <div class="connector-popover-wrap @(isMobile && SettingsMobile.ShowBottomPanel ? "connector-popover-wrap--with-bottom-panel" : "") @(string.IsNullOrWhiteSpace(SettingsSocialWidget.PopoverText) ? "ng-hide": "")" id="connectorPopover" data-popover data-popover-position="topleft" data-popover-is-fixed="true" data-popover-show-on-load="true" 
         data-popover-show-one="true" data-popover-custom-styles="true" data-popover-show-delay="@(string.IsNullOrWhiteSpace(SettingsSocialWidget.PopoverText) ? "0" : "1000")" data-popover-show-cross="@(!string.IsNullOrWhiteSpace(SettingsSocialWidget.PopoverText) ? "true" : "false")">
        @if (!string.IsNullOrWhiteSpace(SettingsSocialWidget.PopoverText))
        {
            @Html.Raw(Model.PoppoverText)
        }
    </div>
}

<div class="connector @(isMobile && SettingsMobile.ShowBottomPanel ? "connector-with-bottom-panel" : "")"
     @Html.Raw(Model.ShowPoppover ? "data-popover-control data-popover-id=\"connectorPopover\" data-popover-trigger=\"null\" data-popover-trigger-hide=\"click\"" : "")>
<input type="checkbox" id="connectorState" class="connector__state" @Html.Raw(oneActive ? "checked=\"checked\"" : "")/>
<ul class="connector__list" dir="rtl">
@if (Model.IsShowVk)
{
    <li class="connector__list-item">
        <a rel="nofollow" href="@LinkService.SocialMedia.Vk/im?sel=-@Model.VkGroupId" target="_blank" class="connector__item connector__item--vkontakte">
            <svg width="56px" height="56px" viewBox="0 0 40 40">
                <use xlink:href="./images/socials/socials.svg?v=2#vk"></use>
            </svg>
        </a>
        <div class="connector__popup">
            ВКонтакте
        </div>
    </li>
}
@if (Model.IsShowFb)
{
    <li class="connector__list-item">
        <a rel="nofollow" href="@LinkService.SocialMedia.MetaMessenger/@Model.FacebookMsgId" target="_blank" class="connector__item connector__item--facebook">
            <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="30px" height="30px" viewBox="0 0 40 40">
                <path fill="currentColor" d="m19.862101,0.6c-10.833493,0 -19.395447,8.037753 -19.395447,17.997577c0,5.59148 2.970474,10.833493 7.338818,13.978701l0,6.814617l6.639883,-3.669409c1.747338,0.524201 3.669409,0.698935 5.59148,0.698935c10.833493,0 19.395447,-8.037753 19.395447,-17.997577c0.174734,-9.610357 -8.911422,-17.822843 -19.570181,-17.822843zm1.922071,24.113258l-4.892545,-5.242013l-9.78509,5.242013l10.484025,-11.357694l5.067279,5.242013l9.610357,-5.242013c0.174734,0.174734 -10.484025,11.357694 -10.484025,11.357694z"/>
            </svg>
        </a>
        <div class="connector__popup">
            Facebook
        </div>
    </li>
}
