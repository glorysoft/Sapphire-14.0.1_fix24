@using AdvantShop.Core.Common.Extensions

@model AdvantShop.Models.Checkout.CheckoutModel
@{
    bool isMobile = SettingsDesign.IsMobileTemplate;
}

<div class="checkout-cart-wrap" data-ng-if="checkout.showCart">
    <article class="checkout-cart cs-bg-4 ">
        <ng-form name="checkoutMiniCart">
            <div data-ng-init="checkout.checkoutMiniCart = checkoutMiniCart" class="checkout-cart-content">
                @if (!isMobile)
                {
                    <div class="checkout-cart__btn-submit-wrap">
                        <button type="submit"
                                class="btn btn-big btn-submit btn-block"
                                data-ng-disabled="checkout.ngSelectPayment == null || checkout.ngSelectShipping == null"
                                data-e2e="btnCheckout"
                                data-ladda="checkout.confirmInProgress"
                                data-ng-class="{'btn-disabled': checkout.checkoutMiniCart.$invalid || cartFullForm.$invalid }"
                                data-button-validation="!((checkout.userUnRegType === 'oldCustomer' || (checkout.checkoutNewCustomerForm != null && checkout.checkoutNewCustomerForm.$invalid)) || checkoutForm.$invalid || checkout.checkoutMiniCart.$invalid || cartFullForm.$invalid || (checkout.checkoutCustomerRequiredFieldsForm != null && checkout.checkoutCustomerRequiredFieldsForm.$invalid))"
                                data-button-validation-start="checkout.checkoutNewCustomerForm.$setSubmitted(); checkout.checkoutNewCustomerForm.$setDirty();"
                                data-button-validation-success="checkout.submitOrder(clickEvent)"
                                data-button-validation-forms="['checkoutNewCustomerForm', 'checkoutForm', 'cartFullForm', 'checkoutCustomerRequiredFieldsForm', 'checkoutMiniCart']">
                            @T("Checkout.CheckoutSummary.ConfirmButtonText")
                        </button>
                        <div data-ng-if="checkout.Cart.Valid" class="checkout-cart-amount-error m-b-xs"
                             data-ng-bind="checkout.Cart.Valid"></div>
                    </div>
                }


                @if (Model.ShoppingCartMode == EShoppingCartMode.Compact)
                {
                    <div class="checkout-cart-items__wrap ng-cloak">
                        <div class="checkout-cart-items__container checkout-cart-items__container--scrollable">
                            <div class="cart-full-items">
                                <div
                                    class="cart-full-items__product checkout-cart-items__product cart-full-product cs-bg-7"
                                    data-ng-repeat="item in checkout.Cart.Items track by $index">
                                    <div class="cart-full-product__info @(Model.ShowProductsPhotoInCheckoutCart ? "cart-full-product__info--two-cols" : String.Empty)">
                                        @if (Model.ShowProductsPhotoInCheckoutCart)
                                        {
                                            <figure
                                                class="cart-full-product__photo">
                                                @if (!(!Model.IsLanding && !Model.IsApi && !SettingsDesign.OnePageCatalog))
                                                {
                                                    <a class="cart-full-product__photo-link"
                                                       data-quickview-trigger
                                                       data-alone="true"
                                                       data-product-id="item.ProductId"
                                                       data-offer-id="item.OfferId">
                                                        <img data-ng-src="{{item.PhotoPath}}" loading="lazy"
                                                             alt="{{item.PhotoAlt}}"/>
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a class="cart-full-product__photo-link"
                                                       data-ng-href="{{item.Link}}">
                                                        <img data-ng-src="{{item.PhotoPath}}" loading="lazy"
                                                             alt="{{item.PhotoAlt}}"/>
                                                    </a>
                                                }
                                            </figure>
                                        }


                                        <div class="cart-full-product__attributes">
                                            <div>
                                                <div class="cart-full-product__cost" data-ng-bind="item.Cost"></div>
                                                <div class="cart-full-product__price">
                                                    <div>
                                                        <div data-ng-if="item.Discount.HasValue && !item.IsGift"
                                                             class="inline price-old cs-t-3">
                                                            <span class="price-number"
                                                                  data-ng-bind="item.CostWithoutDiscount"></span>
                                                        </div>
                                                    </div>
                                                    <div class="cart-full-product__price-rule cs-t-3"
                                                         data-ng-if="item.PriceRuleName"
                                                         data-ng-bind="item.PriceRuleName"></div>
                                                </div>
                                            </div>

                                            @if (!(!Model.IsLanding && !Model.IsApi && !SettingsDesign.OnePageCatalog))
                                            {
                                                <a
                                                    class="cart-full-product__name"
                                                    data-quickview-trigger
                                                    data-alone="true"
                                                    data-product-id="item.ProductId"
                                                    data-offer-id="item.OfferId"
                                                    data-ng-bind="item.Name">
                                                </a>
                                            }
                                            else
                                            {
                                                <a data-ng-href="{{item.Link}}" class="cart-full-product__name"
                                                   data-ng-bind="item.Name"></a>
                                            }
                                            
                                            
                                            <ul class="cart-full-product__properties"
                                                data-ng-if="item.ColorName || item.SizeName || item.SelectedOptions.length > 0">
                                                <li class="cart-full-product__properties-item" data-ng-if="item.ColorName">
                                                    <div class="cart-full-product__properties-name"
                                                         data-ng-bind="(checkout.Cart.ColorHeader + ':')"></div>
                                                    <div class="cart-full-product__properties-value"
                                                         data-ng-bind="item.ColorName"></div>
                                                </li>
                                                <li class="cart-full-product__properties-item" data-ng-if="item.SizeName">
                                                    <div class="cart-full-product__properties-name"
                                                         data-ng-bind="(checkout.Cart.SizeHeader + ':')"></div>
                                                    <div class="cart-full-product__properties-value"
                                                         data-ng-bind="item.SizeName"></div>
                                                </li>
                                                <li
                                                    class="cart-full-product__properties-item"
                                                    data-ng-if="item.SelectedOptions.length > 0"
                                                    data-ng-repeat="option in item.SelectedOptions track by $index">
                                                    <div
                                                        data-ng-if="option.OptionTitle || option.OptionText || option.FormatPrice || option.OptionAmount > 1"
                                                        class="cart-full-product__properties-name"
                                                        data-ng-bind="(option.CustomOptionTitle + (option.OptionTitle ? ':':''))"></div>
                                                    <div class="cart-full-product__properties-value">
                                                        <span
                                                            data-ng-if="!option.OptionTitle && !option.OptionText && !option.FormatPrice && !(option.OptionAmount > 1)">
                                                            {{option.CustomOptionTitle + option.OptionTitle}}
                                                        </span>
                                                        <span data-ng-bind="option.OptionTitle"></span>
                                                        <span data-ng-bind="option.OptionText"></span>
                                                        <span data-ng-bind="option.FormatPrice"></span>
                                                        <span
                                                            data-ng-if="option.OptionAmount != null && option.OptionAmount > 1"
                                                            data-ng-bind="'x ' + option.OptionAmount"></span>
                                                    </div>
                                                </li>
                                            </ul>

                                            @if (Model.ShowBriefDescriptionProductInCheckout)
                                            {
                                                <div data-ng-if="item.BriefDescription.length"
                                                     class="cart-full-product__brief-description">
                                                    <readmore data-line-clamp="4">
                                                        <div data-ng-bind-html="item.BriefDescription"></div>
                                                    </readmore>
                                                </div>
                                            }

                                            <div class="cart-full-product__controls">
                                                <div class="cart-full-product__amount"
                                                     data-ng-if="!item.FrozenAmount && item.AvailableAmount != null">
                                                    @if (Model.AllowEditAmount)
                                                    {
                                                        <div
                                                            class="cart-full-product__amount-control cart-full-amount-control spinbox--mobile"
                                                            data-ng-class="{'cart-full-amount-control--with-unit cart-full-product__amount-control--with-unit' : item.Unit != null}"
                                                            data-spinbox
                                                            data-only-validation="true"
                                                            data-value="item.Amount"
                                                            data-proxy="item.ShoppingCartItemId"
                                                            data-update-fn="checkout.updateCartAmount(value, proxy)"
                                                            data-step="item.Multiplicity"
                                                            data-max="item.MaxAmount"
                                                            data-min="item.MinAmount"></div>
                                                        <span data-ng-if="item.FrozenAmount"
                                                              data-ng-bind="item.Amount"></span>
                                                        <div class="cart-full-product__amount-error-wrap">
                                                            <div class="checkout-cart-amount-error"
                                                                 data-ng-if="item.Avalible == '' && item.AvailableAmount == 0">
                                                                @T("Js.Cart.PreOrder")
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span data-ng-bind="::item.Amount"></span>
                                                    }

                                                </div>
                                                @if (Model.AllowEditAmount)
                                                {
                                                    <div class="cart-full-product__btns">
                                                        <a
                                                            href="javascript:void(0)"
                                                            role="link"
                                                            data-ng-if="!item.IsGift"
                                                            data-ng-click="checkout.removeCartItem($event, item.ShoppingCartItemId)"
                                                            class="cart-full-product__remove-btn btn cart-full-remove-item-btn link-text-decoration-none cs-l-3 input-small"
                                                            title="{{ ::'Js.Cart.Delete' | translate }}"></a>
                                                    </div>
                                                }
                                            </div>
                                            <div class="cart-full-product__additional-info" data-ng-if="!item.FrozenAmount && item.AvailableAmount != null">
                                                <div class="cart-full-product__price-with-discount"
                                                     data-ng-if="item.PriceWithDiscount != null">
                                                    <div class="inline" data-ng-bind="item.PriceWithDiscount"></div>
                                                    <span
                                                        data-ng-bind="'/' + (item.Unit || ('Js.Cart.UnitDefault' | translate))"></span>
                                                </div>
                                                <div class="cart-full-product__amount-error-wrap" data-ng-if="item.Avalible">
                                                    <div class="cart-full-product__amount-error"
                                                         data-ng-bind="item.Avalible"></div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                }
                <div class="checkout-cart__cart-full-summary cart-full-summary">
                    <div class="cart-full-summary__info">
                        <div class="cart-full-summary__row"
                             data-ng-if="checkout.Cart.Cost != null">
                            <div class="cart-full-summary__price-item-name">@T("Checkout.CheckoutCart.Order.Goods")
                                <span data-ng-if="checkout.Cart.TotalItems > 0" data-ng-bind="'(' + checkout.Cart.TotalItems + ')'"></span>
                            </div>
                            <div class="cart-full-summary__price-item-value" data-ng-bind="checkout.Cart.Cost"></div>
                        </div>


                        <div class="cart-full-summary__row"
                             data-ng-if="checkout.Cart.Delivery != null">
                            <div
                                class="cart-full-summary__price-item-name">@T("Checkout.CheckoutCart.DeliveryCost")</div>
                            <div class="cart-full-summary__price-item-value"
                                 data-ng-bind="checkout.Cart.Delivery"></div>

                        </div>


                        <div class="cart-full-summary__row"
                             data-ng-if="checkout.Cart.Payment != null">
                            <div class="cart-full-summary__price-item-name"
                                 data-ng-bind="checkout.Cart.Payment.Key"></div>
                            <div class="cart-full-summary__price-item-value"
                                 data-ng-bind="checkout.Cart.Payment.Value"></div>
                        </div>


                        <div class="cart-full-summary__row"
                             data-ng-if="checkout.Cart.Discount != null">
                            <div class="cart-full-summary__price-item-name">
                                @T("Checkout.CheckoutCart.Discount")
                                <span ng-if="checkout.Cart.Discount.Key != null">
                                    (
                                    <span class="cart-full-discount">-
                                        <span
                                            data-ng-bind="checkout.Cart.Discount.Key"></span>%</span>)
                                </span>
                            </div>
                            <div class="cart-full-summary__price-item-value">
                                -
                                <span data-ng-bind="checkout.Cart.Discount.Value"></span>
                            </div>
                        </div>


                        <div class="cart-full-summary__row"
                             data-ng-if="checkout.Cart.Certificate != null">
                            <div class="checkout-cart-generated-cell checkout-cart-generated-name">
                                <div
                                    class="cart-full-summary__price-item-name">@T("Checkout.CheckoutCart.Certificate")</div>
                            </div>
                            <div class="cart-full-summary__price-item-value">
                                <span data-ng-bind="checkout.Cart.Certificate"></span>
                                <a href="javascript:void(0)" data-cards-remove data-type="certificate"
                                   data-apply-fn="checkout.deleteCard()"></a>
                            </div>
                        </div>


                        <div class="cart-full-summary__row"
                             data-ng-if="checkout.Cart.Coupon != null">
                            <div
                                class="cart-full-summary__price-item-name">@T("Checkout.CheckoutCart.Coupon") (
                                <span
                                    data-ng-bind="checkout.Cart.Coupon.Code"></span>)
                            </div>

                            <div class="cart-full-summary__price-item-value">
                                <span
                                    data-ng-if="checkout.Cart.Coupon.Price != null || checkout.Cart.Coupon.Percent != null">-</span>
                                <span data-ng-bind="checkout.Cart.Coupon.Price"></span>
                                <span
                                    data-ng-if="checkout.Cart.Coupon.Percent != null">(
                                    <span
                                        data-ng-bind="checkout.Cart.Coupon.Percent"></span>%)</span>
                                <img alt="" data-ng-if="checkout.Cart.Coupon.NotApplied" src="images/misc/q.png"
                                     title="@T("Checkout.CheckoutCart.CouponNotApplied")">
                                <a href="javascript:void(0)" data-cards-remove data-type="coupon"
                                   data-apply-fn="checkout.deleteCard()"></a>
                            </div>
                        </div>


                        <div class="cart-full-summary__row checkout-tax"
                             data-ng-if="checkout.Cart.Taxes != null"
                             data-ng-repeat="item in checkout.Cart.Taxes track by $index">
                            <div class="cart-full-summary__price-item-name"
                                 data-ng-bind="item.Key"></div>
                            <div class="cart-full-summary__price-item-value"
                                 data-ng-bind="item.Value"></div>
                        </div>

                        <div class="cart-full-summary__row"
                             data-ng-if="checkout.Cart.Bonuses != null">
                            <div class="cart-full-summary__price-item-name">@T("Checkout.CheckoutCart.Bonuses")</div>

                            <div class="cart-full-summary__price-item-value">
                                - <span data-ng-bind="checkout.Cart.Bonuses"></span>
                            </div>
                        </div>
                        <div class="cart-full-summary__row"
                             data-ng-if="checkout.Cart.BonusPlus != null">
                            <div class="checkout-cart-generated-field-text cart-full-summary__price-item-name">@T("Checkout.CheckoutCart.BonusPlus")</div>
                            <div class="cart-full-summary__price-item-value">+ <span data-ng-bind="checkout.Cart.BonusPlus"></span></div>
                        </div>
                    </div>
                    <div class="cart-full-summary__row cart-full-summary__total">
                        <div class="cart-full-summary__result-block-name cart-full-summary__total-name">@T("Checkout.CheckoutCart.Total")</div>
                        <div class="cart-full-summary__result-block-price cart-full-summary__total-value"
                             data-ng-bind="checkout.Cart.Result"></div>
                    </div>


                    @if (!Model.IsLanding && !Model.IsApi)
                    {
                        <div class="checkout-cart__special-links-wrap"
                             data-ng-if="@((Model.ShoppingCartMode == EShoppingCartMode.Compact).ToLowerString()) || checkout.Cart.ShowInCart || checkout.Cart.BuyOneClickEnabled">
                            @if (Model.ShoppingCartMode == EShoppingCartMode.Compact)
                            {
                                <div class="checkout-cart-verify" data-ng-if="::checkout.Cart.ShowInCart">
                                    <a class="link-dotted-invert" href="cart">@T("Checkout.CheckoutCart.GoToCart")</a>
                                </div>
                            }

                            <div class="checkout-cart-oneclick" data-ng-if="::checkout.Cart.BuyOneClickEnabled">
                                <div class="checkout-cart-oneclick-wrap">
                                    <a href="javascript:void(0)" role="link" class="cs-l-d-1 link-dotted-invert"
                                       data-buy-one-click-trigger="true"
                                       data-buy-one-click-modal="modalBuyOneClickInCheckout">
                                        @SettingsCheckout.BuyInOneClickLinkText
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </ng-form>
    </article>
</div>