@{
    var anyActive = SettingsSocial.LinkVkActive || SettingsSocial.LinkFacebookActive 
                                                || SettingsSocial.LinkYoutubeActive || SettingsSocial.LinkInstagrammActive 
                                                || SettingsSocial.LinkTelegramActive || SettingsSocial.LinkTwitterActive 
                                                || SettingsSocial.LinkOkActive || SettingsSocial.LinkYandexZenActive 
                                                || SettingsSocial.LinkRutubeActive || SettingsSocial.LinkMaxActive;
}
@if (anyActive)
{
    <!--noindex-->
    <div class="col-xs footer-menu">
        <div class="footer-menu-head cs-t-3">
            @T("Home.SocialLinks.Title")
        </div>
        <ul class="footer-menu-list social-list">

            @if (SettingsSocial.LinkVkActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social social--vkontakte  icon-no-margin" aria-label="ВКонтакте" href="@SettingsSocial.LinkVk" target="_blank" rel="nofollow">
                        <svg width="30" height="30" viewBox="0 0 40 40">
                            <use xlink:href="./images/socials/socials.svg?v=2#vk"></use>
                        </svg>
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkVk" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">ВКонтакте</span>
                    </a>
                </li>
            }
            @if (SettingsSocial.LinkFacebookActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social social--facebook icon-facebook-before icon-no-margin" aria-label="Facebook" href="@SettingsSocial.LinkFacebook" target="_blank" rel="nofollow">
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkFacebook" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">Facebook</span>
                    </a>
                </li>
            }
            @if (SettingsSocial.LinkYoutubeActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social social--youtube icon-youtube-before icon-no-margin" aria-label="Youtube" href="@SettingsSocial.LinkYoutube" target="_blank" rel="nofollow">
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkYoutube" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">Youtube</span>
                    </a>
                </li>
            }
            @if (SettingsSocial.LinkInstagrammActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social social--instagram icon-instagram-before icon-no-margin" aria-label="Instagram" href="@SettingsSocial.LinkInstagramm" target="_blank" rel="nofollow">
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkInstagramm" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">Instagram</span>
                    </a>
                </li>
            }
            @if (SettingsSocial.LinkTelegramActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social social--telegram icon-telegram-before icon-no-margin" aria-label="Telegram" href="@SettingsSocial.LinkTelegram" target="_blank" rel="nofollow">
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkTelegram" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">Telegram</span>
                    </a>
                </li>
            }
            @if (SettingsSocial.LinkTwitterActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social--X social icon-no-margin" aria-label="X" href="@SettingsSocial.LinkTwitter" target="_blank" rel="nofollow">
                        <svg width="50px" height="50px" viewBox="0 0 40 40">
                            <use xlink:href="./images/socials/socials.svg?v=2#x"></use>
                        </svg>
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkTwitter" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">X</span>
                    </a>
                </li>
            }
            @if (SettingsSocial.LinkOkActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social social--odnoklassniki icon-odnoklassniki-before icon-no-margin" aria-label="Одноклассники" href="@SettingsSocial.LinkOk" target="_blank" rel="nofollow">
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkOk" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">Одноклассники</span>
                    </a>
                </li>
            }
            @if (SettingsSocial.LinkYandexZenActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social social--yandex-zen icon-yandex-zen-before icon-no-margin" aria-label="Яндекс.Дзен" href="@SettingsSocial.LinkYandexZen" target="_blank" rel="nofollow">
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkYandexZen" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">Яндекс.Дзен</span>
                    </a>
                </li>
            }
            @if (SettingsSocial.LinkRutubeActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social social--rutube icon-rutube-before icon-no-margin" aria-label="Rutube" href="@SettingsSocial.LinkRutube" target="_blank" rel="nofollow">
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkRutube" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">Rutube</span>
                    </a>
                </li>
            }
            @if (SettingsSocial.LinkMaxActive)
            {
                <li class="footer-menu-item">
                    <a class="footer-menu-link cs-l-2 social social--max icon-max-before icon-no-margin" aria-label="Max" href="@SettingsSocial.LinkMax" target="_blank" rel="nofollow">
                    </a>
                    <a class="footer-menu-link cs-l-2" href="@SettingsSocial.LinkMax" target="_blank" rel="nofollow">
                        <span class="footer-menu-text">Max</span>
                    </a>
                </li>
            }
        </ul>
    </div>
    <!--/noindex-->
}